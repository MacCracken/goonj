[package]
name = "goonj"
version = "${file:VERSION}"
description = "goonj — acoustics engine (sound propagation, room simulation, impulse responses). Cyrius port of a 14,630-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/goonj"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "goonj"
# The smoke binary reaches about 14% of what it links. Tests and benches are unaffected.
dce = true

# `[lib]` declares the distlib bundle layout that `cyrius distlib` writes
# into `dist/goonj.cyr` — all 37 acoustics modules concatenated in
# dependency order (deps before dependents). Every module is
# self-contained (no `include` lines); the bundle resolves hisab (HVec3,
# geo) + stdlib + sakshi (for `logging`) from the CONSUMER's manifest.
# Cross-module symbol collisions were audited to zero before enabling
# this (37 modules share one flat namespace once concatenated).
[lib]
modules = [
    "src/error.cyr",
    "src/material.cyr",
    "src/propagation.cyr",
    "src/resonance.cyr",
    "src/ambisonics.cyr",
    "src/scattering.cyr",
    "src/dark_velvet_noise.cyr",
    "src/logging.cyr",
    "src/hybrid.cyr",
    "src/directivity.cyr",
    "src/room.cyr",
    "src/metamaterial.cyr",
    "src/fdn.cyr",
    "src/gfpe.cyr",
    "src/diffusion.cyr",
    "src/fdtd.cyr",
    "src/outdoor.cyr",
    "src/portal.cyr",
    "src/udfa.cyr",
    "src/underwater.cyr",
    "src/vibroacoustics.cyr",
    "src/bridge.cyr",
    "src/ray.cyr",
    "src/radiosity.cyr",
    "src/image_source.cyr",
    "src/dwm.cyr",
    "src/diffuse.cyr",
    "src/diffraction.cyr",
    "src/impulse.cyr",
    "src/analysis.cyr",
    "src/beam.cyr",
    "src/coupled.cyr",
    "src/wav.cyr",
    "src/binaural.cyr",
    "src/dhvani.cyr",
    "src/kiran.cyr",
    "src/soorat.cyr",
]

# stdlib: the base port set plus `math` (clamp/min/max/lerp/sign,
# exp/ln polyfills, F64_* constants) and `ganita` (transcendentals:
# pow/exp/ln/sin/cos/sqrt/acos/atan2/…). Same pairing hisab uses.
# Do NOT also list `matrix`/`linalg` — ganita subsumes them.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "fnptr",
    "bench",
    "simd",
    "sakshi",
]

# hisab — math/geometry (HVec3 and friends). goonj consumes the single
# distlib bundle, same pattern hisab uses for its own deps. Tag is the
# hisab release pinned to this toolchain: 3.5.0 pins exactly 6.7.18.
#
# sakshi (for `logging`) is a stdlib leaf above. Through hisab 3.4.1 it came
# transitively from hisab's `[deps.sakshi]`; hisab 3.4.2 dropped that package
# because nothing in hisab calls it, so goonj names the leaf itself. 6.7.18
# folds sakshi 2.5.10, the same bytes as before.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.5.0"
modules = ["dist/hisab.cyr"]
