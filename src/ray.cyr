# ray.cyr -- acoustic ray tracing: single-band (AcousticRay) and
# multiband (MultibandRay) rays, planar wall intersection, specular +
# scattering reflection, and linear / BVH-accelerated path tracing.
#
# Ports rust-old/src/ray.rs. f32 -> f64. Rust's `serde` derive is dropped.
# Option<f32> from ray_wall_intersection becomes a negative sentinel
# (RAY_NONE); Option<(f32,usize)> from find_nearest_wall* becomes a
# NearestWall struct pointer (0 == None). The `[f32; NUM_BANDS]` energy
# arrays (MultibandRay, RayBounce, RayPath) use manual inline layout.
# Uses hisab geo (geo_ray_new, bvh_query_ray) for BVH broadphase and
# room.cyr's Wall / AcceleratedRoom types.
#
# Requires (build/test unit): error.cyr (GOONJ_EPSILON), material.cyr
# (NUM_BANDS, am_scattering, AM_ABS, frequency_band), room.cyr (Wall_*,
# AcceleratedRoom_*, AcousticRoom_*, RoomGeometry_walls), hisab, stdlib
# math/vec. alloc_init() must have run.

var ENERGY_THRESHOLD = 0x3F50624DD2F1A9FC;   # 0.001 — dead below this
var RAY_NONE         = 0xBFF0000000000000;   # -1.0 — "no intersection" sentinel
var RAY_MIN_DIRECTION_SQ = 0x3E7AD7F29ABCAF48;   # 1e-7 — hisab's EPSILON_F32

# ================================================================
# Structs
# ================================================================
#derive(accessors)
struct AcousticRay { origin; direction; energy; frequency_hz; distance_traveled; }

#derive(accessors)
struct RayHit { point; normal; distance; wall_index; }

#derive(accessors)
struct NearestWall { distance; index; }

# MultibandRay: origin | direction | energy[8] | distance  (manual layout).
enum MbrLayout { MBR_ORIGIN = 0, MBR_DIR = 8, MBR_ENERGY = 16, MBR_DIST = 80, MBR_SIZE = 88 }

# RayBounce: point | normal | wall_index | dist_from_prev | energy_after[8].
enum RbLayout { RB_POINT = 0, RB_NORMAL = 8, RB_WIDX = 16, RB_DIST = 24, RB_ENERGY = 32, RB_SIZE = 96 }

# RayPath: bounces (vec) | total_distance | final_energy[8].
enum RpLayout { RP_BOUNCES = 0, RP_TOTAL = 8, RP_FINAL = 16, RP_SIZE = 80 }

# Origin of multiband ray `r` (HVec3).
fn mbr_origin(r)            { return load64(r + MBR_ORIGIN); }
# Direction of multiband ray `r` (HVec3).
fn mbr_direction(r)         { return load64(r + MBR_DIR); }
# Energy of multiband ray `r` in frequency band `i`.
fn mbr_energy_band(r, i) {
    if (i < 0) { return 0; }
    if (i >= NUM_BANDS) { return 0; }
    return load64(r + MBR_ENERGY + i * 8);
}
# Set the energy of multiband ray `r` in frequency band `i` to `v`.
fn mbr_set_energy_band(r, i, v) {
    if (i < 0) { return 0; }
    if (i >= NUM_BANDS) { return 0; }
    store64(r + MBR_ENERGY + i * 8, v);
    return 0;
}
# Distance travelled by multiband ray `r`.
fn mbr_distance(r)          { return load64(r + MBR_DIST); }

# Bounces of path `p`, as a vec of RayBounce.
fn ray_path_bounces(p)      { return load64(p + RP_BOUNCES); }
# Total distance travelled along path `p`.
fn ray_path_total_distance(p) { return load64(p + RP_TOTAL); }
# Final energy of path `p` in frequency band `i`.
fn ray_path_final_energy(p, i) {
    if (i < 0) { return 0; }
    if (i >= NUM_BANDS) { return 0; }
    return load64(p + RP_FINAL + i * 8);
}

# Hit point of bounce `b` (HVec3).
fn ray_bounce_point(b)      { return load64(b + RB_POINT); }
# Surface normal at bounce `b` (HVec3).
fn ray_bounce_normal(b)     { return load64(b + RB_NORMAL); }
# Index of the wall hit at bounce `b`.
fn ray_bounce_wall_index(b) { return load64(b + RB_WIDX); }
# Distance from the previous origin to bounce `b` (the ray source for the first).
fn ray_bounce_distance(b)   { return load64(b + RB_DIST); }
# Energy left in frequency band `i` after the absorption at bounce `b`.
fn ray_bounce_energy_after(b, i) {
    if (i < 0) { return 0; }
    if (i >= NUM_BANDS) { return 0; }
    return load64(b + RB_ENERGY + i * 8);
}

# ================================================================
# AcousticRay
# ================================================================
# Normalize direction into `out`; zero-length falls back to +Z.
fn _ray_norm_into(out, direction) {
    var len = hvec3_length(direction);
    if (f64_gt(len, GOONJ_EPSILON) == 1) { return _v3_scale(out, direction, f64_div(F64_ONE, len)); }
    return _v3_set(out, 0, 0, F64_ONE);
}

# Normalize direction; zero-length falls back to +Z.
#must_use
fn _ray_norm_dir(direction) {
    var out = hvec3_zero();
    _ray_norm_into(out, direction);
    return out;
}

# New ray with full energy at `frequency_hz`; a zero direction falls back to +Z.
#must_use
fn acoustic_ray_new(origin, direction, frequency_hz) {
    var r = alloc(sizeof(AcousticRay));
    AcousticRay_set_origin(r, origin);
    AcousticRay_set_direction(r, _ray_norm_dir(direction));
    AcousticRay_set_energy(r, F64_ONE);
    AcousticRay_set_frequency_hz(r, frequency_hz);
    AcousticRay_set_distance_traveled(r, 0);
    return r;
}

# 1 while the ray's energy is above ENERGY_THRESHOLD, else 0.
#must_use
fn acoustic_ray_is_alive(r) {
    if (f64_gt(AcousticRay_energy(r), ENERGY_THRESHOLD) == 1) { return 1; }
    return 0;
}

# ================================================================
# MultibandRay
# ================================================================
# Fill `r`, an MBR_SIZE buffer, as a new ray along the already-normalized `unit_dir`.
fn _multiband_ray_init(r, origin, unit_dir) {
    store64(r + MBR_ORIGIN, origin);
    store64(r + MBR_DIR, unit_dir);
    var i = 0;
    while (i < NUM_BANDS) {
        store64(r + MBR_ENERGY + i * 8, F64_ONE);
        i = i + 1;
    }
    store64(r + MBR_DIST, 0);
    return 0;
}

# New ray with full energy in every band; a zero direction falls back to +Z.
#must_use
fn multiband_ray_new(origin, direction) {
    var r = alloc(MBR_SIZE);
    _multiband_ray_init(r, origin, _ray_norm_dir(direction));
    return r;
}

# 1 while any band's energy is above ENERGY_THRESHOLD, else 0.
#must_use
fn multiband_ray_is_alive(r) {
    var i = 0;
    while (i < NUM_BANDS) {
        if (f64_gt(mbr_energy_band(r, i), ENERGY_THRESHOLD) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Largest energy across all frequency bands.
#must_use
fn multiband_ray_max_energy(r) {
    var m = 0;
    var i = 0;
    while (i < NUM_BANDS) {
        m = goonj_fmax(m, mbr_energy_band(r, i));
        i = i + 1;
    }
    return m;
}

# ================================================================
# Geometry: planar wall intersection + point-in-polygon
# ================================================================
# Inside test for a convex polygon (vertices is a vec of HVec3).
#must_use
fn point_in_convex_polygon(point, vertices, normal) {
    var n = vec_len(vertices);
    if (n < 3) { return 0; }
    var edge: i64[3];
    var to_point: i64[3];
    var c: i64[3];
    var i = 0;
    while (i < n) {
        var v0 = vec_get(vertices, i);
        var v1 = vec_get(vertices, (i + 1) % n);
        _v3_sub(&edge, v1, v0);
        _v3_sub(&to_point, point, v0);
        _v3_cross(&c, &edge, &to_point);
        if (f64_lt(hvec3_dot(&c, normal), f64_neg(GOONJ_EPSILON)) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ray_wall_intersection from an origin and a direction, with no AcousticRay to build.
#must_use
fn _ray_wall_t(origin, direction, wall) {
    var verts = Wall_vertices(wall);
    if (vec_len(verts) < 3) { return RAY_NONE; }

    var n = Wall_normal(wall);
    var d_dot_n = hvec3_dot(direction, n);
    if (f64_lt(f64_abs(d_dot_n), GOONJ_EPSILON) == 1) { return RAY_NONE; }

    var diff: i64[3];
    _v3_sub(&diff, vec_get(verts, 0), origin);
    var t = f64_div(hvec3_dot(&diff, n), d_dot_n);
    if (f64_lt(t, GOONJ_EPSILON) == 1) { return RAY_NONE; }

    var along: i64[3];
    var hit: i64[3];
    _v3_scale(&along, direction, t);
    _v3_add(&hit, origin, &along);
    if (point_in_convex_polygon(&hit, verts, n) == 1) { return t; }
    return RAY_NONE;
}

# Ray-wall intersection distance, or RAY_NONE (negative) if no hit.
#must_use
fn ray_wall_intersection(ray, wall) {
    return _ray_wall_t(AcousticRay_origin(ray), AcousticRay_direction(ray), wall);
}

# ================================================================
# Reflection
# ================================================================
# Reflection direction into `out`, which may be `d`: specular r = d - 2(d·n)n,
# blended toward the normal by `scattering`.
fn _reflect_into(out, d, n, scattering) {
    var twice: i64[3];
    _v3_scale(&twice, n, f64_mul(F64_TWO, hvec3_dot(d, n)));
    _v3_sub(out, d, &twice);
    if (f64_gt(scattering, GOONJ_EPSILON) == 1) {
        var from_specular: i64[3];
        var from_normal: i64[3];
        var blended: i64[3];
        _v3_scale(&from_specular, out, f64_sub(F64_ONE, scattering));
        _v3_scale(&from_normal, n, scattering);
        _v3_add(&blended, &from_specular, &from_normal);
        var len = hvec3_length(&blended);
        if (f64_gt(len, GOONJ_EPSILON) == 1) { _v3_scale(out, &blended, f64_div(F64_ONE, len)); }
    }
    return 0;
}

# _reflect_into for a direction the result keeps.
#must_use
fn _reflect_direction(d, n, scattering) {
    var out = hvec3_zero();
    _reflect_into(out, d, n, scattering);
    return out;
}

# Reflect `ray` at `hit`: energy falls by `absorption`, `scattering` blends specular and diffuse.
#must_use
fn reflect_ray(ray, hit, absorption, scattering) {
    var dir = _reflect_direction(AcousticRay_direction(ray), RayHit_normal(hit), scattering);
    var r = alloc(sizeof(AcousticRay));
    AcousticRay_set_origin(r, RayHit_point(hit));
    AcousticRay_set_direction(r, dir);
    AcousticRay_set_energy(r, f64_mul(AcousticRay_energy(ray), f64_sub(F64_ONE, absorption)));
    AcousticRay_set_frequency_hz(r, AcousticRay_frequency_hz(ray));
    AcousticRay_set_distance_traveled(r, f64_add(AcousticRay_distance_traveled(ray), RayHit_distance(hit)));
    return r;
}

# `absorption` is a pointer to 8 consecutive f64 (per-band coefficients).
#must_use
fn reflect_ray_multiband(ray, hit, absorption, scattering) {
    var dir = _reflect_direction(mbr_direction(ray), RayHit_normal(hit), scattering);
    var r = alloc(MBR_SIZE);
    store64(r + MBR_ORIGIN, RayHit_point(hit));
    store64(r + MBR_DIR, dir);
    var i = 0;
    while (i < NUM_BANDS) {
        var e = f64_mul(mbr_energy_band(ray, i), f64_sub(F64_ONE, load64(absorption + i * 8)));
        store64(r + MBR_ENERGY + i * 8, e);
        i = i + 1;
    }
    store64(r + MBR_DIST, f64_add(mbr_distance(ray), RayHit_distance(hit)));
    return r;
}

# Pointer to a wall's material absorption block (8 f64). AM_ABS is the
# absorption offset inside AcousticMaterial (material.cyr).
#must_use
fn _wall_absorption_ptr(wall) { return Wall_material(wall) + AM_ABS; }

# ================================================================
# Nearest-wall search (linear + BVH) and path tracing
# ================================================================
# Nearest wall into `out`, a NearestWall-sized buffer. 1 on a hit, 0 for None.
fn _nearest_wall(origin, direction, walls, skip_wall, out) {
    var found = 0;
    var best_t = 0;
    var best_idx = 0;
    var n = vec_len(walls);
    var i = 0;
    while (i < n) {
        if (i != skip_wall) {
            var t = _ray_wall_t(origin, direction, vec_get(walls, i));
            # RAY_NONE is Rust's None. A NaN t is Rust's Some(NaN), which is a hit.
            if (f64_lt(t, 0) == 0) {
                if (found == 0) {
                    found = 1; best_t = t; best_idx = i;
                } else {
                    if (f64_lt(t, best_t) == 1) { best_t = t; best_idx = i; }
                }
            }
        }
        i = i + 1;
    }
    if (found == 0) { return 0; }
    NearestWall_set_distance(out, best_t);
    NearestWall_set_index(out, best_idx);
    return 1;
}

# A heap NearestWall from a stack one.
#must_use
fn _nearest_wall_keep(nw) {
    var kept = alloc(sizeof(NearestWall));
    NearestWall_set_distance(kept, NearestWall_distance(nw));
    NearestWall_set_index(kept, NearestWall_index(nw));
    return kept;
}

# Returns a NearestWall (distance,index) or 0 (None). skip_wall = -1 for none.
#must_use
fn find_nearest_wall(origin, direction, walls, skip_wall) {
    var nw: i64[2];
    if (_nearest_wall(origin, direction, walls, skip_wall, &nw) == 0) { return 0; }
    return _nearest_wall_keep(&nw);
}

# BVH broadphase _nearest_wall. A direction Rust's Ray::new rejects -> None. hisab's Rust
# tests len_sq < 1e-7 (EPSILON_F32, geo/primitives.rs:30), a magnitude of 3.16e-4.
# Both refusals below would otherwise read as "no wall hit", so they end the process
# like any other (ADR-0004). hisab's BVH reports no leaf for a NaN slab, so a non-finite
# ray hits nothing here, where the linear search returns Rust's NaN hits (ADR-0005).
fn _nearest_wall_bvh(origin, direction, walls, bvh, skip_wall, out) {
    if (f64_lt(hvec3_length_sq(direction), RAY_MIN_DIRECTION_SQ) == 1) { return 0; }
    var hray = geo_ray_new(origin, direction);
    if (hray == 0) { goonj_alloc_refused(); }
    var candidates = bvh_query_ray(bvh, hray);
    if (candidates == 0) { goonj_alloc_refused(); }

    var found = 0;
    var best_t = 0;
    var best_idx = 0;
    var m = vec_len(candidates);
    var j = 0;
    while (j < m) {
        var idx = vec_get(candidates, j);
        if (idx != skip_wall) {
            var t = _ray_wall_t(origin, direction, vec_get(walls, idx));
            if (f64_lt(t, 0) == 0) {
                if (found == 0) {
                    found = 1; best_t = t; best_idx = idx;
                } else {
                    if (f64_lt(t, best_t) == 1) { best_t = t; best_idx = idx; }
                }
            }
        }
        j = j + 1;
    }
    if (found == 0) { return 0; }
    NearestWall_set_distance(out, best_t);
    NearestWall_set_index(out, best_idx);
    return 1;
}

# BVH broadphase variant of find_nearest_wall.
#must_use
fn find_nearest_wall_bvh(origin, direction, walls, bvh, skip_wall) {
    var nw: i64[2];
    if (_nearest_wall_bvh(origin, direction, walls, bvh, skip_wall, &nw) == 0) { return 0; }
    return _nearest_wall_keep(&nw);
}

# Fill a RayBounce's fields other than its point.
fn _fill_bounce(b, normal, wall_index, distance, ray_after) {
    store64(b + RB_NORMAL, normal);
    store64(b + RB_WIDX, wall_index);
    store64(b + RB_DIST, distance);
    var k = 0;
    while (k < NUM_BANDS) {
        store64(b + RB_ENERGY + k * 8, mbr_energy_band(ray_after, k));
        k = k + 1;
    }
    return 0;
}

# Record bounce number `b`. With `reuse`, an earlier ray's RayBounce is overwritten, so a
# caller tracing many rays keeps one set of them (generate_diffuse_rain).
fn _record_bounce(bounces, reuse, b, point, normal, wall_index, distance, ray_after) {
    if (reuse == 1) {
        if (b < vec_len(bounces)) {
            var old = vec_get(bounces, b);
            _v3_copy(ray_bounce_point(old), point);
            return _fill_bounce(old, normal, wall_index, distance, ray_after);
        }
    }
    var kept = alloc(RB_SIZE);
    store64(kept + RB_POINT, _v3_keep(point));
    _fill_bounce(kept, normal, wall_index, distance, ray_after);
    vec_push(bounces, kept);
    return 0;
}

# Assemble a RayPath from accumulated bounces + the final ray state.
#must_use
fn _make_path(bounces, current) {
    var path = alloc(RP_SIZE);
    store64(path + RP_BOUNCES, bounces);
    store64(path + RP_TOTAL, mbr_distance(current));
    var k = 0;
    while (k < NUM_BANDS) {
        store64(path + RP_FINAL + k * 8, mbr_energy_band(current, k));
        k = k + 1;
    }
    return path;
}

# Walk `ray` through `walls`, bouncing up to `max_bounces` times. One walk, stack buffers
# throughout, for trace_ray, trace_ray_bvh and generate_diffuse_rain: per bounce it keeps
# a RayBounce and its point, and with `reuse` not even those. `state` is an MBR_SIZE
# buffer that ends holding the final energy and distance. Returns the bounce count.
fn _trace_walk(ray, walls, bvh, use_bvh, max_bounces, bounces, reuse, state) {
    var origin: i64[3];
    var dir: i64[3];
    var along: i64[3];
    var nw: i64[2];
    _v3_copy(&origin, mbr_origin(ray));
    _v3_copy(&dir, mbr_direction(ray));
    var k = 0;
    while (k < NUM_BANDS) {
        store64(state + MBR_ENERGY + k * 8, mbr_energy_band(ray, k));
        k = k + 1;
    }
    store64(state + MBR_DIST, mbr_distance(ray));

    var last_wall = 0 - 1;
    var b = 0;
    var go = 1;
    while (go == 1) {
        if (b >= max_bounces) { go = 0; }
        if (go == 1) {
            if (multiband_ray_is_alive(state) == 0) { go = 0; }
        }
        if (go == 1) {
            var hit = 0;
            if (use_bvh == 1) {
                hit = _nearest_wall_bvh(&origin, &dir, walls, bvh, last_wall, &nw);
            } else {
                hit = _nearest_wall(&origin, &dir, walls, last_wall, &nw);
            }
            if (hit == 0) {
                go = 0;
            } else {
                var idx = NearestWall_index(&nw);
                var t = NearestWall_distance(&nw);
                var wall = vec_get(walls, idx);
                _v3_scale(&along, &dir, t);
                _v3_add(&origin, &origin, &along);
                _reflect_into(&dir, &dir, Wall_normal(wall), am_scattering(Wall_material(wall)));
                var absorption = _wall_absorption_ptr(wall);
                k = 0;
                while (k < NUM_BANDS) {
                    var e = f64_mul(mbr_energy_band(state, k), f64_sub(F64_ONE, load64(absorption + k * 8)));
                    store64(state + MBR_ENERGY + k * 8, e);
                    k = k + 1;
                }
                store64(state + MBR_DIST, f64_add(mbr_distance(state), t));
                _record_bounce(bounces, reuse, b, &origin, Wall_normal(wall), idx, t, state);
                last_wall = idx;
                b = b + 1;
            }
        }
    }
    return b;
}

# Trace a multiband ray through a vec of walls, recording each bounce.
#must_use
fn trace_ray(ray, walls, max_bounces) {
    var state: i64[11];
    var bounces = vec_new();
    _trace_walk(ray, walls, 0, 0, max_bounces, bounces, 0, &state);
    return _make_path(bounces, &state);
}

# BVH-accelerated trace through an AcceleratedRoom.
#must_use
fn trace_ray_bvh(ray, accel_room, max_bounces) {
    var room = AcceleratedRoom_room(accel_room);
    var walls = RoomGeometry_walls(AcousticRoom_geometry(room));
    var bvh = AcceleratedRoom_bvh(accel_room);
    var state: i64[11];
    var bounces = vec_new();
    _trace_walk(ray, walls, bvh, 1, max_bounces, bounces, 0, &state);
    return _make_path(bounces, &state);
}
