# fdtd.cyr -- 2D FDTD modal solver per Botteldooren 1995.
#
# Explicit finite-difference time-domain solver for the 2D acoustic wave
# equation `d2p/dt2 = c^2 grad^2 p` on a regular Cartesian grid with rigid
# (Neumann) boundaries. Best for low-frequency modal behaviour below the
# Schroeder frequency, where ray methods break down and interference
# dominates. Reference: Botteldooren, JASA 98(6), 1995.
#
# Ports rust-old/src/fdtd.rs. The solver runs in f32, as Rust's did (ADR-0010): the
# config's dx, speed and duration and each source sample are rounded to f32 on the way
# in, the grid holds f32, and results come back as f64 vecs of f32 values, so on the
# same input they are Rust's bits. band_energies stays f64. Rust's `serde` derive on the
# config/source/receiver/result structs is dropped (no serde in Cyrius); the two serde
# round-trip tests are therefore omitted. The `[f32; 8]` band-energy return becomes an
# alloc'd 8xf64 buffer (read with load64(buf + band*8)), mirroring hybrid.cyr.
#
# Requires (from the build/test unit): material.cyr (NUM_BANDS,
# frequency_band), stdlib math/ganita (F64_*, f64_*), vec, and alloc;
# alloc_init() must have run.

# Courant-Friedrichs-Lewy upper bound for 2D FDTD: c*dt/dx <= 1/sqrt(2), as Rust's
# f32 FRAC_1_SQRT_2 (0.70710677) widened.
var CFL_2D_LIMIT = 0x3FE6A09E60000000;
# Maximum allowed grid cells nx*ny to bound memory.
var MAX_GRID_CELLS = 4000000;
# Maximum allowed time-step count to bound runtime.
var MAX_TIME_STEPS = 1000000;

# ================================================================
# FdtdConfig -- simulation parameters for a rigid-walled box.
#   sample_rate (int), dx (f64), speed_of_sound (f64), nx (int),
#   ny (int), duration_seconds (f64).
# ================================================================
#derive(accessors)
struct FdtdConfig {
    sample_rate;
    dx;
    speed_of_sound;
    nx;
    ny;
    duration_seconds;
}

# Build an FdtdConfig for an nx x ny grid with cell size dx.
#must_use
fn fdtd_config_new(sample_rate, dx, speed_of_sound, nx, ny, duration_seconds) {
    var c = alloc(sizeof(FdtdConfig));
    FdtdConfig_set_sample_rate(c, sample_rate);
    FdtdConfig_set_dx(c, dx);
    FdtdConfig_set_speed_of_sound(c, speed_of_sound);
    FdtdConfig_set_nx(c, nx);
    FdtdConfig_set_ny(c, ny);
    FdtdConfig_set_duration_seconds(c, duration_seconds);
    return c;
}

# Rust Default: 22050 Hz, dx 0.05 m, c 343 m/s, 80x80, 0.5 s.
#must_use
fn fdtd_config_default() {
    return fdtd_config_new(22050, pct(5), f64_from(343), 80, 80, F64_HALF);
}

# ================================================================
# FdtdSource -- additive pressure source at one grid cell.
#   ix (int), iy (int), signal (vec of f64 samples).
# ================================================================
#derive(accessors)
struct FdtdSource {
    ix;
    iy;
    signal;
}

# Source at grid cell (ix, iy) playing `signal`, a vec of f64 samples.
#must_use
fn fdtd_source_new(ix, iy, signal) {
    var s = alloc(sizeof(FdtdSource));
    FdtdSource_set_ix(s, ix);
    FdtdSource_set_iy(s, iy);
    FdtdSource_set_signal(s, signal);
    return s;
}

# Gaussian pulse centred at peak_step with width sigma_steps; energy spread covers ~6 sigma
# steps. A broad-spectrum impulse. Computed in f32, as Rust's was (_g32_gaussian_pulse).
#must_use
fn fdtd_source_gaussian_pulse(ix, iy, peak_step, sigma_steps, amplitude) {
    return fdtd_source_new(ix, iy, _g32_gaussian_pulse(peak_step, sigma_steps, amplitude, MAX_TIME_STEPS));
}

# ================================================================
# FdtdReceiver -- a grid cell whose pressure history is recorded.
# ================================================================
#derive(accessors)
struct FdtdReceiver {
    ix;
    iy;
}

# Receiver at grid cell (ix, iy).
#must_use
fn fdtd_receiver_new(ix, iy) {
    var r = alloc(sizeof(FdtdReceiver));
    FdtdReceiver_set_ix(r, ix);
    FdtdReceiver_set_iy(r, iy);
    return r;
}

# ================================================================
# FdtdResult -- solver output.
#   receiver_signals (vec of inner vecs, one per receiver),
#   final_pressure (vec, row-major y*nx + x), time_steps (int),
#   dt (f64, effective time step).
# ================================================================
#derive(accessors)
struct FdtdResult {
    receiver_signals;
    final_pressure;
    time_steps;
    dt;
}

# Empty result for degenerate input (Rust's empty_result()).
#must_use
fn fdtd_empty_result() {
    var r = alloc(sizeof(FdtdResult));
    FdtdResult_set_receiver_signals(r, vec_new());
    FdtdResult_set_final_pressure(r, vec_new());
    FdtdResult_set_time_steps(r, 0);
    FdtdResult_set_dt(r, 0);
    return r;
}

# ================================================================
# solve_fdtd_2d -- solve the 2D acoustic wave equation on a rigid box.
# `receivers` is a vec of FdtdReceiver pointers. Returns an empty result
# on degenerate input (zero grid, sub-CFL dt, out-of-range source, etc.).
# Runs in f32, as Rust's did (ADR-0010).
# ================================================================
#must_use
fn solve_fdtd_2d(config, source, receivers) {
    var sample_rate = FdtdConfig_sample_rate(config);
    # Rust's FdtdConfig holds these as f32, so every test and step below sees them so.
    var dx = _g32_of(FdtdConfig_dx(config));
    var speed_of_sound = _g32_of(FdtdConfig_speed_of_sound(config));
    var nx = FdtdConfig_nx(config);
    var ny = FdtdConfig_ny(config);
    var duration = _g32_of(FdtdConfig_duration_seconds(config));

    if (sample_rate <= 0) {
        return fdtd_empty_result();
    }
    if (f64_le(_g32_wide(dx), 0) == 1) {
        return fdtd_empty_result();
    }
    if (f64_le(_g32_wide(speed_of_sound), 0) == 1) {
        return fdtd_empty_result();
    }
    if (nx < 3) {
        return fdtd_empty_result();
    }
    if (ny < 3) {
        return fdtd_empty_result();
    }
    if (f64_le(_g32_wide(duration), 0) == 1) {
        return fdtd_empty_result();
    }
    # Rust used saturating_mul here (rust-old/src/fdtd.rs:157). A plain i64
    # multiply wraps: nx=4, ny=2^62+1 wraps to 4 and slips the cap, after which
    # the solver sweeps the true dimensions over a tiny allocation. Bound each
    # extent first so the product (<= 1.6e13) cannot wrap.
    if (nx > MAX_GRID_CELLS) {
        return fdtd_empty_result();
    }
    if (ny > MAX_GRID_CELLS) {
        return fdtd_empty_result();
    }
    if (nx * ny > MAX_GRID_CELLS) {
        return fdtd_empty_result();
    }

    var source_ix = FdtdSource_ix(source);
    var source_iy = FdtdSource_iy(source);
    # FdtdSource.ix/iy were `usize` in Rust (rust-old/src/fdtd.rs:77-79), so
    # `>= nx` was a complete bound. As signed i64 the lower half is gone and a
    # negative index reaches the store below, writing before the grid buffer.
    if (source_ix < 0) {
        return fdtd_empty_result();
    }
    if (source_iy < 0) {
        return fdtd_empty_result();
    }
    if (source_ix >= nx) {
        return fdtd_empty_result();
    }
    if (source_iy >= ny) {
        return fdtd_empty_result();
    }

    # dt = 1 / sample_rate and cfl = c * dt / dx, in f32 (rust-old/src/fdtd.rs:166-167).
    var dt = _g32_div(G32_ONE, _g32_int(sample_rate));
    var cfl = _g32_div(_g32_mul(speed_of_sound, dt), dx);
    if (f64_gt(_g32_wide(cfl), CFL_2D_LIMIT) == 1) {
        return fdtd_empty_result();
    }

    # Rust: `(duration / dt) as u32` then `.min(MAX)`, the division in f32. The `as` cast
    # SATURATES — NaN and negatives to 0, overflow to u32::MAX — so a huge duration runs the
    # CAP. Before cyrius 6.6.8 f64_to gave INT64_MIN there, which is neither
    # > MAX nor == 0, so the step loop silently ran ZERO times. Clamp in f64
    # first: f64_to saturates now, but it still keeps the sign (ADR-0003).
    var steps_f = _g32_wide(_g32_div(duration, dt));
    var num_steps = 0;
    if (f64_ge(steps_f, f64_from(MAX_TIME_STEPS)) == 1) {
        num_steps = MAX_TIME_STEPS;
    }
    if (f64_gt(steps_f, 0) == 1) {
        if (f64_lt(steps_f, f64_from(MAX_TIME_STEPS)) == 1) {
            num_steps = f64_to(steps_f);
        }
    }
    if (num_steps == 0) {
        return fdtd_empty_result();
    }

    var n = nx * ny;
    var p_prev = _g32_zeros(n);
    var p_curr = _g32_zeros(n);
    var p_next = _g32_zeros(n);
    var cfl_sq = _g32_mul(cfl, cfl);

    var source_signal = FdtdSource_signal(source);
    var siglen = vec_len(source_signal);
    var sidx = source_iy * nx + source_ix;

    # One inner trace vec per receiver (empty for out-of-range receivers).
    var receiver_signals = vec_new();
    var nrecv = vec_len(receivers);
    var ri = 0;
    while (ri < nrecv) {
        vec_push(receiver_signals, vec_new());
        ri = ri + 1;
    }

    var top_row = (ny - 1) * nx;
    var below_top = (ny - 2) * nx;

    # The interior runs in chunks of whole rows, each one span from (1, y0) to (nx - 2, y1) in
    # row-major order. A span takes in the x = 0 and x = nx - 1 cells between its rows too,
    # which read the wrong neighbours, but the walls below overwrite every one of them, as
    # Rust's do (ADR-0010). Scratch for the f32 kernels, and the scalars they multiply by.
    var rows = _row32_rows_per_chunk(nx);
    var cap = rows * nx;
    var t_lap = _g32_zeros(cap);
    var t_lead = _g32_zeros(cap);
    var k_four = _g32_zeros(cap);
    var k_two = _g32_zeros(cap);
    var k_cfl_sq = _g32_zeros(cap);
    _row32_fill(k_four, G32_FOUR, cap);
    _row32_fill(k_two, G32_TWO, cap);
    _row32_fill(k_cfl_sq, cfl_sq, cap);

    var step = 0;
    while (step < num_steps) {
        # Interior 5-point Laplacian + leapfrog update, in Rust's order
        # (rust-old/src/fdtd.rs:192-197):
        #   lap = (((left + right) + below) + above) - 4 * c
        #   next = (2 * c - prev) + cfl_sq * lap
        var y0 = 1;
        while (y0 < ny - 1) {
            var y1 = y0 + rows - 1;
            if (y1 > ny - 2) { y1 = ny - 2; }
            var first = (y0 * nx + 1) * 4;
            var len = (y1 - y0 + 1) * nx - 2;
            var c = p_curr + first;
            _row32_add(t_lap, c - 4, c + 4, len);
            _row32_add(t_lap, t_lap, c - nx * 4, len);
            _row32_add(t_lap, t_lap, c + nx * 4, len);
            _row32_mul(t_lead, k_four, c, len);
            _row32_sub(t_lap, t_lap, t_lead, len);
            _row32_mul(t_lap, k_cfl_sq, t_lap, len);
            _row32_mul(t_lead, k_two, c, len);
            _row32_sub(t_lead, t_lead, p_prev + first, len);
            _row32_add(p_next + first, t_lead, t_lap, len);
            y0 = y1 + 1;
        }

        # Rigid walls: copy the adjacent interior cell (dp/dn = 0).
        var ex = 1;
        while (ex < nx - 1) {
            store32(p_next + ex * 4, load32(p_next + (ex + nx) * 4));
            store32(p_next + (top_row + ex) * 4, load32(p_next + (below_top + ex) * 4));
            ex = ex + 1;
        }
        var ey = 1;
        while (ey < ny - 1) {
            var lrow = ey * nx;
            store32(p_next + lrow * 4, load32(p_next + (lrow + 1) * 4));
            store32(p_next + (lrow + nx - 1) * 4, load32(p_next + (lrow + nx - 2) * 4));
            ey = ey + 1;
        }

        # Corners: average of adjacent edges, 0.5 * (a + b).
        var bl = _g32_add(load32(p_next + 4), load32(p_next + nx * 4));
        store32(p_next, _g32_mul(G32_HALF, bl));
        var br = _g32_add(load32(p_next + (nx - 2) * 4), load32(p_next + (2 * nx - 1) * 4));
        store32(p_next + (nx - 1) * 4, _g32_mul(G32_HALF, br));
        var tl = _g32_add(load32(p_next + (top_row + 1) * 4), load32(p_next + (top_row - nx) * 4));
        store32(p_next + top_row * 4, _g32_mul(G32_HALF, tl));
        var trc = _g32_add(load32(p_next + (top_row + nx - 2) * 4),
          load32(p_next + (top_row + nx - 1 - nx) * 4));
        store32(p_next + (top_row + nx - 1) * 4, _g32_mul(G32_HALF, trc));

        # Source injection (additive). Rust's signal is f32, so each sample is rounded first.
        if (step < siglen) {
            var s = _g32_of(vec_get(source_signal, step));
            store32(p_next + sidx * 4, _g32_add(load32(p_next + sidx * 4), s));
        }

        # Sample receivers.
        var rj = 0;
        while (rj < nrecv) {
            var rx = vec_get(receivers, rj);
            var rxix = FdtdReceiver_ix(rx);
            var rxiy = FdtdReceiver_iy(rx);
            # FdtdReceiver.ix/iy were `usize` in Rust (rust-old/src/fdtd.rs:112-114).
            # An out-of-grid receiver keeps its empty trace, as in the oracle.
            var inrange = 1;
            if (rxix < 0) { inrange = 0; }
            if (rxiy < 0) { inrange = 0; }
            if (rxix >= nx) { inrange = 0; }
            if (rxiy >= ny) { inrange = 0; }
            if (inrange == 1) {
                var trace = vec_get(receiver_signals, rj);
                vec_push(trace, _g32_wide(load32(p_next + (rxiy * nx + rxix) * 4)));
            }
            rj = rj + 1;
        }

        # Rotate buffers: prev<-curr, curr<-next, next<-old prev.
        var tmp = p_prev;
        p_prev = p_curr;
        p_curr = p_next;
        p_next = tmp;

        step = step + 1;
    }

    var result = alloc(sizeof(FdtdResult));
    FdtdResult_set_receiver_signals(result, receiver_signals);
    # final_pressure snapshot = current field after the last rotation.
    FdtdResult_set_final_pressure(result, _g32_to_vec(p_curr, n));
    FdtdResult_set_time_steps(result, num_steps);
    FdtdResult_set_dt(result, _g32_wide(dt));
    return result;
}

# Zero an 8-band (NUM_BANDS) f64 buffer.
fn _fdtd_zero_bands(out) {
    var i = 0;
    while (i < NUM_BANDS) {
        store64(out + i * 8, 0);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# band_energies -- per-band energies from a time-domain signal via a
# single-bin Goertzel evaluation at each ISO octave centre frequency.
# `signal` is a vec of f64 samples. Returns an alloc'd NUM_BANDS x f64
# buffer of |X(f_band)|^2, clamped to >= 0.
# ================================================================
#must_use
fn band_energies(signal, sample_rate) {
    var out = alloc(NUM_BANDS * 8);
    var siglen = vec_len(signal);
    if (siglen == 0) {
        _fdtd_zero_bands(out);
        return out;
    }
    if (sample_rate <= 0) {
        _fdtd_zero_bands(out);
        return out;
    }
    var inv_sr = f64_div(F64_ONE, f64_from(sample_rate));
    var band = 0;
    while (band < NUM_BANDS) {
        var f = frequency_band(band);
        var omega = f64_mul(f64_mul(F64_TAU, f), inv_sr);
        var coeff = f64_mul(F64_TWO, f64_cos(omega));
        var s_prev = 0;
        var s_prev2 = 0;
        var i = 0;
        while (i < siglen) {
            var x = vec_get(signal, i);
            var s = f64_sub(f64_add(x, f64_mul(coeff, s_prev)), s_prev2);
            s_prev2 = s_prev;
            s_prev = s;
            i = i + 1;
        }
        var sq = f64_add(f64_mul(s_prev, s_prev), f64_mul(s_prev2, s_prev2));
        var mag = f64_sub(sq, f64_mul(f64_mul(coeff, s_prev), s_prev2));
        store64(out + band * 8, f64_max(mag, 0));
        band = band + 1;
    }
    return out;
}
