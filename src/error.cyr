# error.cyr -- goonj error codes, shared tolerances and shared helpers
# Usage: included by build/test entry; do not `include` other src modules.
#
# Ports rust-old/src/error.rs (GoonjError enum). Rust carried a String
# payload per variant; Cyrius uses integer codes — functions return 0
# (ERR_NONE) on success or a negative code on failure. Diagnostic
# strings, where needed, come from goonj_err_name().

var ERR_NONE              = 0;
var ERR_INVALID_GEOMETRY  = (0 - 1);   # invalid room/wall geometry (too few vertices, etc.)
var ERR_INVALID_MATERIAL  = (0 - 2);   # invalid material params (absorption outside 0..1)
var ERR_INVALID_FREQUENCY = (0 - 3);   # invalid frequency (negative Hz, etc.)
var ERR_PROPAGATION_FAILED = (0 - 4);  # propagation computation failed
var ERR_COMPUTATION       = (0 - 5);   # general computation error (e.g. WAV export I/O)

# ================================================================
# Shared tolerances / sentinels (f64 bit patterns)
# ================================================================
# goonj's Rust source was f32; the Cyrius port is f64 throughout
# (hisab's HVec3 is f64-only). GOONJ_EPSILON preserves the f32::EPSILON
# guard thresholds the Rust code used, promoted to f64.
var GOONJ_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 1.1920929e-7
var F64_NEG_INF   = 0xFFF0000000000000;   # -inf (pressure_to_db_spl of <=0 pressure)

# 1 if `code` is an error (negative), 0 otherwise.
fn goonj_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (for diagnostics / logging).
fn goonj_err_name(code) {
    if (code == ERR_NONE) { return "none"; }
    if (code == ERR_INVALID_GEOMETRY) { return "invalid geometry"; }
    if (code == ERR_INVALID_MATERIAL) { return "invalid material"; }
    if (code == ERR_INVALID_FREQUENCY) { return "invalid frequency"; }
    if (code == ERR_PROPAGATION_FAILED) { return "propagation failed"; }
    if (code == ERR_COMPUTATION) { return "computation error"; }
    return "unknown error";
}

# ================================================================
# Shared helpers
# ================================================================
# Rust's f32::min and f32::max ignore a NaN on either side. f64_min and f64_max
# ignore one only in the first position: f64_max(1, NaN) is NaN. Anything that can
# see NaN in the second position comes here (ADR-0002 rule 4). Without a NaN these
# are the same bits as f64_min and f64_max.
fn goonj_fmin(a, b) {
    if (f64_eq(a, a) == 0) { return b; }
    if (f64_eq(b, b) == 0) { return a; }
    return f64_min(a, b);
}

# NaN-ignoring maximum. See goonj_fmin.
fn goonj_fmax(a, b) {
    if (f64_eq(a, a) == 0) { return b; }
    if (f64_eq(b, b) == 0) { return a; }
    return f64_max(a, b);
}

# End the process over a refused allocation, as Rust's alloc does (ADR-0004).
fn goonj_alloc_refused() {
    syscall(SYS_WRITE, 2, "goonj: allocation refused\n", 26);
    syscall(SYS_EXIT, 1);
    return 0;
}

# alloc for a size that depends on input. A 0 here must not reach a store: the
# first write could land anywhere, not just in the null page (ADR-0004).
#must_use
fn goonj_alloc(size) {
    var p = alloc(size);
    if (p == 0) { goonj_alloc_refused(); }
    return p;
}

# Shorter than this, insertion sort is faster and needs no scratch memory.
var GOONJ_SORT_INSERTION_MAX = 32;

fn _goonj_insertion_sort(v, keys, n) {
    var i = 1;
    while (i < n) {
        var item = vec_get(v, i);
        var k = load64(keys + i * 8);
        var j = i - 1;
        var go = 1;
        while (go == 1) {
            if (j < 0) { go = 0; }
            if (go == 1) {
                if (f64_gt(load64(keys + j * 8), k) == 1) {
                    vec_set(v, j + 1, vec_get(v, j));
                    store64(keys + (j + 1) * 8, load64(keys + j * 8));
                    j = j - 1;
                } else {
                    go = 0;
                }
            }
        }
        vec_set(v, j + 1, item);
        store64(keys + (j + 1) * 8, k);
        i = i + 1;
    }
    return 0;
}

# Merge the sorted runs [lo, mid) and [mid, hi) of (src_k, src_v) into (dst_k, dst_v).
# Ties take the left run, which is what makes the sort stable.
fn _goonj_merge(src_k, src_v, dst_k, dst_v, lo, mid, hi) {
    var a = lo;
    var b = mid;
    var out = lo;
    while (out < hi) {
        var from_left = 1;
        if (a >= mid) {
            from_left = 0;
        } else {
            if (b < hi) {
                if (f64_gt(load64(src_k + a * 8), load64(src_k + b * 8)) == 1) { from_left = 0; }
            }
        }
        if (from_left == 1) {
            store64(dst_k + out * 8, load64(src_k + a * 8));
            store64(dst_v + out * 8, load64(src_v + a * 8));
            a = a + 1;
        } else {
            store64(dst_k + out * 8, load64(src_k + b * 8));
            store64(dst_v + out * 8, load64(src_v + b * 8));
            b = b + 1;
        }
        out = out + 1;
    }
    return 0;
}

# Stable ascending sort of vec `v` by the f64 `key_fn(item)`, as Rust's
# sort_by(partial_cmp) is. Stable sorts of the same keys agree bit for bit, so this
# replaced four quadratic insertion sorts without moving a result. O(n log n).
fn goonj_sort_by_key(v, key_fn) {
    var n = vec_len(v);
    if (n < 2) { return 0; }
    var keys = goonj_alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(keys + i * 8, fncall1(key_fn, vec_get(v, i)));
        i = i + 1;
    }
    if (n <= GOONJ_SORT_INSERTION_MAX) { return _goonj_insertion_sort(v, keys, n); }

    var vals = goonj_alloc(n * 8);
    i = 0;
    while (i < n) {
        store64(vals + i * 8, vec_get(v, i));
        i = i + 1;
    }
    var tmp_k = goonj_alloc(n * 8);
    var tmp_v = goonj_alloc(n * 8);
    var width = 1;
    while (width < n) {
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            if (mid > n) { mid = n; }
            var hi = mid + width;
            if (hi > n) { hi = n; }
            _goonj_merge(keys, vals, tmp_k, tmp_v, lo, mid, hi);
            lo = hi;
        }
        var swap_k = keys;
        keys = tmp_k;
        tmp_k = swap_k;
        var swap_v = vals;
        vals = tmp_v;
        tmp_v = swap_v;
        width = width * 2;
    }
    i = 0;
    while (i < n) {
        vec_set(v, i, load64(vals + i * 8));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Vector out-params (ADR-0007)
# ================================================================
# hisab's hvec3_add, hvec3_sub, hvec3_scale, hvec3_neg and hvec3_cross each allocate
# their result, and the allocator never frees. These form the same bits into `out`, an
# HVec3-sized buffer the caller owns, usually a `var v: i64[3]` on its stack. The stack
# buffer must not outlive the call: anything a result keeps goes through _v3_keep.
# `out` may alias an input, except in _v3_cross.
fn _v3_set(out, x, y, z) {
    HVec3_set_x(out, x);
    HVec3_set_y(out, y);
    HVec3_set_z(out, z);
    return 0;
}

fn _v3_copy(out, v) {
    return _v3_set(out, HVec3_x(v), HVec3_y(v), HVec3_z(v));
}

fn _v3_add(out, a, b) {
    f64v_add(out, a, b, 2);
    HVec3_set_z(out, f64_add(HVec3_z(a), HVec3_z(b)));
    return 0;
}

fn _v3_sub(out, a, b) {
    f64v_sub(out, a, b, 2);
    HVec3_set_z(out, f64_sub(HVec3_z(a), HVec3_z(b)));
    return 0;
}

fn _v3_scale(out, v, s) {
    f64v_scale(out, v, s, 2);
    HVec3_set_z(out, f64_mul(HVec3_z(v), s));
    return 0;
}

fn _v3_neg(out, v) {
    return _v3_set(out, f64_neg(HVec3_x(v)), f64_neg(HVec3_y(v)), f64_neg(HVec3_z(v)));
}

fn _v3_cross(out, a, b) {
    return _v3_set(out,
      f64_sub(f64_mul(HVec3_y(a), HVec3_z(b)), f64_mul(HVec3_z(a), HVec3_y(b))),
      f64_sub(f64_mul(HVec3_z(a), HVec3_x(b)), f64_mul(HVec3_x(a), HVec3_z(b))),
      f64_sub(f64_mul(HVec3_x(a), HVec3_y(b)), f64_mul(HVec3_y(a), HVec3_x(b))));
}

# A heap copy of `v`, for a vector a result keeps.
#must_use
fn _v3_keep(v) {
    var kept = hvec3_new(HVec3_x(v), HVec3_y(v), HVec3_z(v));
    if (kept == 0) { goonj_alloc_refused(); }
    return kept;
}

# The element storage of a vec, for the f64v_* array builtins. lib/vec.cyr documents the
# layout as { data_ptr, len, cap }, matching lib/slice.cyr. Stale after any push.
#must_use
fn _vec_data(v) {
    return load64(v);
}

# ================================================================
# Array ops (ADR-0008)
# ================================================================
# Row kernels call these, never the builtins directly. f64v_* steps two lanes and
# f64v256_* four, with no scalar tail, so a length that isn't a multiple rounds UP:
# f64v_add(out, a, b, 1) writes two elements. These touch exactly `n` elements and give
# the same bits as the scalar expression, on either path. `out` may be `a` or `b`, but
# must not overlap them at an offset.

# Below this a row stays on 128-bit lanes. Measured on the solvers: the ymm kernels lose to
# them under about 64 elements, once each call's vzeroupper is paid (ADR-0008).
var ROW_WIDE_MIN = 64;

# 1 = use the 256-bit kernels, 0 = don't, 2 = not probed yet. f64v256_* is an illegal
# instruction without AVX2, so this comes from the CPU. Only a test sets it otherwise.
var _row_wide = 2;

# Elements of an `n`-long row for the 256-bit kernels: a multiple of 4, or 0.
#must_use
fn _row_wide_len(n) {
    if (_row_wide == 2) { _row_wide = simd_has_avx2(); }
    if (_row_wide == 0) { return 0; }
    return n & (0 - 4);
}

fn _row_add(out, a, b, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row_wide_len(n); }
    if (wide > 0) { f64v256_add(out, a, b, wide); }
    var even = n & (0 - 2);
    if (even > wide) {
        f64v_add(out + wide * 8, a + wide * 8, b + wide * 8, even - wide);
    }
    if (even != n) {
        store64(out + even * 8, f64_add(load64(a + even * 8), load64(b + even * 8)));
    }
    return 0;
}

fn _row_sub(out, a, b, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row_wide_len(n); }
    if (wide > 0) { f64v256_sub(out, a, b, wide); }
    var even = n & (0 - 2);
    if (even > wide) {
        f64v_sub(out + wide * 8, a + wide * 8, b + wide * 8, even - wide);
    }
    if (even != n) {
        store64(out + even * 8, f64_sub(load64(a + even * 8), load64(b + even * 8)));
    }
    return 0;
}

fn _row_mul(out, a, b, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row_wide_len(n); }
    if (wide > 0) { f64v256_mul(out, a, b, wide); }
    var even = n & (0 - 2);
    if (even > wide) {
        f64v_mul(out + wide * 8, a + wide * 8, b + wide * 8, even - wide);
    }
    if (even != n) {
        store64(out + even * 8, f64_mul(load64(a + even * 8), load64(b + even * 8)));
    }
    return 0;
}

fn _row_scale(out, a, s, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row_wide_len(n); }
    if (wide > 0) { f64v256_scale(out, a, s, wide); }
    var even = n & (0 - 2);
    if (even > wide) {
        f64v_scale(out + wide * 8, a + wide * 8, s, even - wide);
    }
    if (even != n) {
        store64(out + even * 8, f64_mul(load64(a + even * 8), s));
    }
    return 0;
}

# ================================================================
# f32 grids (ADR-0010)
# ================================================================
# fdtd, dwm and diffusion hold their fields in f32 and compute in f32, as the Rust original
# did, so on the same input they give its bits. An f32 lives as its 32-bit pattern: store32
# and load32 move one, a `var x: f32` local does f32 arithmetic on it, _g32_of rounds an f64
# to it and _g32_wide widens it back exactly. Comparisons widen first, which gives the f32
# comparison's answer.

# f32 constants, as bit patterns.
enum GoonjF32 {
    G32_HALF    = 0x3F000000,
    G32_ONE     = 0x3F800000,
    G32_TWO     = 0x40000000,
    G32_FOUR    = 0x40800000,
    G32_EPSILON = 0x34000000,   # f32::EPSILON = 1.1920929e-7
}

# The f32 nearest x, an f64, ties to even: what Rust's `as f32` or an f32 field holds.
#must_use
fn _g32_of(x) {
    return f32_from(x) & 0xFFFFFFFF;
}

# The f32 bit pattern b as its exact f64.
#must_use
fn _g32_wide(b) {
    return f32_to(b);
}

# The f32 nearest a non-negative integer n, as Rust's `n as f32`.
#must_use
fn _g32_int(n) {
    return _g32_of(f64_from(n));
}

# f32 a + b, for the scalar paths. Each reads its operands as f32 bit patterns. They are
# untyped parameters because an integer constant passed to an f32 one warns.
#must_use
fn _g32_add(a, b) {
    var x: f32 = a;
    var y: f32 = b;
    var r: f32 = x + y;
    return r & 0xFFFFFFFF;
}

# f32 a - b. See _g32_add.
#must_use
fn _g32_sub(a, b) {
    var x: f32 = a;
    var y: f32 = b;
    var r: f32 = x - y;
    return r & 0xFFFFFFFF;
}

# f32 a * b. See _g32_add.
#must_use
fn _g32_mul(a, b) {
    var x: f32 = a;
    var y: f32 = b;
    var r: f32 = x * y;
    return r & 0xFFFFFFFF;
}

# f32 a / b. See _g32_add.
#must_use
fn _g32_div(a, b) {
    var x: f32 = a;
    var y: f32 = b;
    var r: f32 = x / y;
    return r & 0xFFFFFFFF;
}

# Rust's f32::max: a NaN on either side is ignored. Without one, the larger, as f64_max.
#must_use
fn _g32_max(a, b) {
    return _g32_of(goonj_fmax(_g32_wide(a), _g32_wide(b)));
}

# The grid solvers run their interiors in chunks of whole rows, at most this many elements
# where a row allows it: a chunk's operands and scratch stay in L1, and the scratch stays a
# few KB whatever the grid (ADR-0010). Chunking can't move a result: every kernel is
# elementwise.
var ROW32_CHUNK = 1024;

# Rows per chunk for a grid whose rows are `nx` long, at least one.
#must_use
fn _row32_rows_per_chunk(nx) {
    var r = ROW32_CHUNK / nx;
    if (r < 1) { r = 1; }
    return r;
}

# Elements of an `n`-long f32 row for the 256-bit kernels: a multiple of 8, or 0.
#must_use
fn _row32_wide_len(n) {
    if (_row_wide == 2) { _row_wide = simd_has_avx2(); }
    if (_row_wide == 0) { return 0; }
    return n & (0 - 8);
}

# The f32 row kernels. f32v_* steps four lanes and f32v8_* eight, with no scalar tail, so
# f32v_add(out, a, b, 5) writes eight elements. These touch exactly `n`, and give the scalar
# f32 expression's bits on every path. `out` may be `a` or `b`, but must not overlap them at
# an offset. There is no packed scale: a scalar operand is a row filled by _row32_fill.
fn _row32_add(out, a, b, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row32_wide_len(n); }
    if (wide > 0) { f32v8_add(out, a, b, wide); }
    var quad = n & (0 - 4);
    if (quad > wide) {
        f32v_add(out + wide * 4, a + wide * 4, b + wide * 4, quad - wide);
    }
    for (var i = quad; i < n; i = i + 1) {
        var x: f32 = load32(a + i * 4);
        var y: f32 = load32(b + i * 4);
        var r: f32 = x + y;
        store32(out + i * 4, r);
    }
    return 0;
}

# out = a - b over an f32 row. See _row32_add.
fn _row32_sub(out, a, b, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row32_wide_len(n); }
    if (wide > 0) { f32v8_sub(out, a, b, wide); }
    var quad = n & (0 - 4);
    if (quad > wide) {
        f32v_sub(out + wide * 4, a + wide * 4, b + wide * 4, quad - wide);
    }
    for (var i = quad; i < n; i = i + 1) {
        var x: f32 = load32(a + i * 4);
        var y: f32 = load32(b + i * 4);
        var r: f32 = x - y;
        store32(out + i * 4, r);
    }
    return 0;
}

# out = a * b over an f32 row. See _row32_add.
fn _row32_mul(out, a, b, n) {
    var wide = 0;
    if (n >= ROW_WIDE_MIN) { wide = _row32_wide_len(n); }
    if (wide > 0) { f32v8_mul(out, a, b, wide); }
    var quad = n & (0 - 4);
    if (quad > wide) {
        f32v_mul(out + wide * 4, a + wide * 4, b + wide * 4, quad - wide);
    }
    for (var i = quad; i < n; i = i + 1) {
        var x: f32 = load32(a + i * 4);
        var y: f32 = load32(b + i * 4);
        var r: f32 = x * y;
        store32(out + i * 4, r);
    }
    return 0;
}

# Fill an f32 row with the bit pattern k, for a scalar operand of the kernels above.
fn _row32_fill(out, k, n) {
    for (var i = 0; i < n; i = i + 1) { store32(out + i * 4, k); }
    return 0;
}

# A zeroed f32 buffer of n elements. alloc's bytes are zero, and 0.0's bit pattern is 0.
#must_use
fn _g32_zeros(n) {
    return goonj_alloc(n * 4);
}

# A vec of the n f32 elements at p, each widened to its exact f64.
#must_use
fn _g32_to_vec(p, n) {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) { vec_push(v, _g32_wide(load32(p + i * 4))); }
    return v;
}

# The f32 samples of a Gaussian pulse centred on step `peak_step`, `sigma_steps` wide, about
# 6 sigma long, each widened to f64. fdtd's and dwm's gaussian_pulse share this, as Rust's
# two were the same code (rust-old/src/fdtd.rs:96-104, dwm.rs:273-281). It runs in f32 as
# Rust did. exp is f64's, rounded to f32: Rust's expf can differ from that in the last bit.
# Rust's length had no ceiling. `cap` bounds it in f64 (ADR-0003): a solver reads the
# signal only below its step cap. NaN and anything below 1 give one sample, as `.max(1)`.
#must_use
fn _g32_gaussian_pulse(peak_step, sigma_steps, amplitude, cap) {
    if (peak_step < 0) { peak_step = 0; }   # u32 in Rust
    var peak = _g32_int(peak_step);
    var sigma = _g32_of(sigma_steps);
    var amp = _g32_of(amplitude);
    var span = f64_ceil(_g32_wide(_g32_add(peak, _g32_mul(_g32_of(f64_from(6)), sigma))));
    var n = 1;
    if (f64_ge(span, f64_from(cap)) == 1) { n = cap; }
    if (f64_gt(span, F64_ONE) == 1) {
        if (f64_lt(span, f64_from(cap)) == 1) { n = f64_to(span); }
    }
    var inv_sigma = _g32_div(G32_ONE, _g32_max(sigma, G32_ONE));
    var neg_half = _g32_of(f64_neg(F64_HALF));
    var signal = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var arg = _g32_mul(_g32_sub(_g32_int(i), peak), inv_sigma);
        var e = _g32_mul(_g32_mul(neg_half, arg), arg);
        var g = _g32_of(f64_exp(_g32_wide(e)));
        vec_push(signal, _g32_wide(_g32_mul(amp, g)));
    }
    return signal;
}
