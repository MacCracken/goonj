# dwm.cyr -- 3D rectilinear Digital Waveguide Mesh (Smith / Van Duyne):
# wave-based room acoustics on a regular lattice with per-face IIR
# boundary reflection filters, plus dispersion characterization/correction.
#
# Ports rust-old/src/dwm.rs. The mesh runs in f32, as Rust's did (ADR-0010): the
# config, the wall filters and each source sample are rounded to f32 on the way in,
# the mesh holds f32, and results come back as f64 vecs of f32 values, so on the same
# input they are Rust's bits. The dispersion helpers stay f64. serde dropped. Flat-namespace
# care: the co-compiled `fdtd` already defines MAX_GRID_CELLS,
# MAX_TIME_STEPS and band_energies, so this module uses DWM_-prefixed grid
# constants, `dwm_band_energies` (delegates to fdtd's `band_energies`), and
# `_dwm_`-prefixed private helpers.
#
# Requires (build/test unit): error.cyr, material.cyr (NUM_BANDS, am_*,
# _am_make), hybrid.cyr, fdtd.cyr (band_energies), stdlib math/ganita/vec.
# alloc_init() first. The solve_dwm_3d grid solver uses raw f32 buffers for the
# hot triple-loop (pressure is copied to a vec only for the result); receiver
# signals accumulate as vecs.

var DWM_SQRT_3         = 0x3FFBB67AE6502B91;   # 1.7320508  (√3), for the f64 helpers
# The mesh's constants are Rust's f32 values, widened (rust-old/src/dwm.rs:46-62).
var DWM_SQRT_3_F32     = 0x3FFBB67AE0000000;   # 1.7320508f32
var DWM_K              = 6;                     # waveguide ports per node
var DWM_SCATTER        = 0x3FD5555560000000;   # 2/K = 0.33333334f32
var DWM_MAX_GRID_CELLS = 4000000;
var DWM_MAX_TIME_STEPS = 1000000;
var DWM_DX_WARN_TOL    = 0x3F847AE140000000;   # 0.01f32
var DWM_DX_FAIL_TOL    = 0x3FB99999A0000000;   # 0.10f32
var DWM_DEFAULT_BOOST  = 0x3FF0CCCCCCCCCCCD;   # 1.05
var DWM_DX_DEFAULT     = 0x3F9B9628CBD1244A;   # 0.02694
var DWM_DUR_DEFAULT    = 0x3FA999999999999A;   # 0.05
var DWM_POS_099        = 0x3FEFAE1480000000;   # 0.99f32, the wall filter's pole bound
var DWM_NEG_099        = 0xBFEFAE1480000000;   # -0.99f32

# ================================================================
# WallMaterials — per-face materials (each an AcousticMaterial ptr).
# ================================================================
#derive(accessors)
struct WallMaterials { x_neg; x_pos; y_neg; y_pos; z_neg; z_pos; }

# Per-wall materials for the six faces of a DWM room.
#must_use
fn wall_materials_new(x_neg, x_pos, y_neg, y_pos, z_neg, z_pos) {
    var w = alloc(sizeof(WallMaterials));
    WallMaterials_set_x_neg(w, x_neg);
    WallMaterials_set_x_pos(w, x_pos);
    WallMaterials_set_y_neg(w, y_neg);
    WallMaterials_set_y_pos(w, y_pos);
    WallMaterials_set_z_neg(w, z_neg);
    WallMaterials_set_z_pos(w, z_pos);
    return w;
}

# All six faces share one material (read-only sharing; Rust cloned).
#must_use
fn wall_materials_uniform(material) {
    return wall_materials_new(material, material, material, material, material, material);
}

# Fully rigid walls: zero absorption everywhere (R = 1).
#must_use
fn wall_materials_rigid() {
    return wall_materials_uniform(_am_make("rigid", 0, 0, 0, 0, 0, 0, 0, 0, 0));
}

# ================================================================
# DwmConfig
# ================================================================
#derive(accessors)
struct DwmConfig { sample_rate; dx; speed_of_sound; nx; ny; nz; duration_seconds; wall_materials; }

# Build a DwmConfig for an nx x ny x nz grid with cell size dx.
#must_use
fn dwm_config_new(sample_rate, dx, speed_of_sound, nx, ny, nz, duration_seconds, wall_materials) {
    var c = alloc(sizeof(DwmConfig));
    DwmConfig_set_sample_rate(c, sample_rate);
    DwmConfig_set_dx(c, dx);
    DwmConfig_set_speed_of_sound(c, speed_of_sound);
    DwmConfig_set_nx(c, nx);
    DwmConfig_set_ny(c, ny);
    DwmConfig_set_nz(c, nz);
    DwmConfig_set_duration_seconds(c, duration_seconds);
    DwmConfig_set_wall_materials(c, wall_materials);
    return c;
}

# Default: 22050 Hz, dx≈0.02694, c=343, 30×25×20, 0.05 s, rigid walls.
#must_use
fn dwm_config_default() {
    return dwm_config_new(22050, DWM_DX_DEFAULT, f64_from(343), 30, 25, 20,
      DWM_DUR_DEFAULT, wall_materials_rigid());
}

# Builder: set all faces to one material; mutate + return the config.
#must_use
fn dwm_config_with_acoustic_material(config, material) {
    DwmConfig_set_wall_materials(config, wall_materials_uniform(material));
    return config;
}
# Set `config`'s wall materials in place and return `config`.
#must_use
fn dwm_config_with_wall_materials(config, walls) {
    DwmConfig_set_wall_materials(config, walls);
    return config;
}

# ================================================================
# BoundaryFilter — 1-pole IIR reflection filter H(z)=b0/(1-a1 z^-1),
# fitted to a material's 63 Hz and 8 kHz absorption.
# ================================================================
#derive(accessors)
struct BoundaryFilter { b0; a1; }

# Fit a BoundaryFilter to the material's lowest and highest band absorption. In f32, as
# Rust's was (rust-old/src/dwm.rs:200-215); b0 and a1 are f32 values, widened.
#must_use
fn boundary_filter_from_material(material) {
    var alpha_low = _g32_of(f64_clamp(am_absorption_band(material, 0), 0, F64_ONE));
    var alpha_high = _g32_of(f64_clamp(am_absorption_band(material, NUM_BANDS - 1), 0, F64_ONE));
    var r_low = _g32_of(f64_sqrt(_g32_wide(_g32_max(_g32_sub(G32_ONE, alpha_low), 0))));
    var r_high = _g32_of(f64_sqrt(_g32_wide(_g32_max(_g32_sub(G32_ONE, alpha_high), 0))));
    var denom = _g32_add(r_low, r_high);
    var a1 = 0;
    if (f64_gt(_g32_wide(denom), _g32_wide(G32_EPSILON)) == 1) {
        var q = _g32_div(_g32_sub(r_low, r_high), denom);
        a1 = _g32_of(f64_clamp(_g32_wide(q), DWM_NEG_099, DWM_POS_099));
    }
    var b0 = _g32_mul(r_low, _g32_sub(G32_ONE, a1));
    var f = alloc(sizeof(BoundaryFilter));
    BoundaryFilter_set_b0(f, _g32_wide(b0));
    BoundaryFilter_set_a1(f, _g32_wide(a1));
    return f;
}

# y[n] = b0·x + a1·prev_y, in f32 with x and prev_y rounded to it, widened back.
#must_use
fn boundary_filter_process(filter, x, prev_y) {
    return _g32_wide(_dwm_process32(filter, _g32_of(x), _g32_of(prev_y)));
}

# ================================================================
# DwmSource / DwmReceiver / DwmResult
# ================================================================
#derive(accessors)
struct DwmSource { ix; iy; iz; signal; }

# Gaussian pulse centred at peak_step, width sigma_steps; ~6σ long. Computed in f32, as
# Rust's was (_g32_gaussian_pulse).
#must_use
fn dwm_source_gaussian_pulse(ix, iy, iz, peak_step, sigma_steps, amplitude) {
    var s = alloc(sizeof(DwmSource));
    DwmSource_set_ix(s, ix);
    DwmSource_set_iy(s, iy);
    DwmSource_set_iz(s, iz);
    DwmSource_set_signal(s, _g32_gaussian_pulse(peak_step, sigma_steps, amplitude, DWM_MAX_TIME_STEPS));
    return s;
}

#derive(accessors)
struct DwmReceiver { ix; iy; iz; }

# Receiver at grid cell (ix, iy, iz).
#must_use
fn dwm_receiver_new(ix, iy, iz) {
    var r = alloc(sizeof(DwmReceiver));
    DwmReceiver_set_ix(r, ix);
    DwmReceiver_set_iy(r, iy);
    DwmReceiver_set_iz(r, iz);
    return r;
}

#derive(accessors)
struct DwmResult { receiver_signals; final_pressure; time_steps; dt; }

#must_use
fn _dwm_empty_result() {
    var r = alloc(sizeof(DwmResult));
    DwmResult_set_receiver_signals(r, vec_new());
    DwmResult_set_final_pressure(r, vec_new());
    DwmResult_set_time_steps(r, 0);
    DwmResult_set_dt(r, 0);
    return r;
}

# Row-major flat index (z*ny + y)*nx + x.
#must_use
fn _dwm_idx(x, y, z, nx, ny) {
    return (z * ny + y) * nx + x;
}

# ================================================================
# Convenience / characterization functions
# ================================================================
# Grid spacing required for a sample rate + sound speed: Δx = c·√3 / fs.
#must_use
fn required_dx(sample_rate, speed_of_sound) {
    if (sample_rate <= 0) { return 0; }
    return f64_div(f64_mul(speed_of_sound, DWM_SQRT_3), f64_from(sample_rate));
}

# Per-band energies (delegates to fdtd's Goertzel helper).
#must_use
fn dwm_band_energies(signal, sample_rate) {
    return band_energies(signal, sample_rate);
}

# Mesh frequency f_mesh = c / (2·Δx); 0 if dx ≤ 0.
#must_use
fn mesh_frequency(config) {
    var dx = DwmConfig_dx(config);
    if (f64_le(dx, 0) == 1) { return 0; }
    return f64_div(DwmConfig_speed_of_sound(config), f64_mul(F64_TWO, dx));
}

# Dispersion factor f_sim/f_true for axis-aligned propagation (1 at DC,
# → 0 at the mesh limit, 0 above it, 1 for invalid input).
#must_use
fn dispersion_factor(config, frequency_hz) {
    if (f64_le(frequency_hz, 0) == 1) { return F64_ONE; }
    if (DwmConfig_sample_rate(config) <= 0) { return F64_ONE; }
    if (f64_le(DwmConfig_speed_of_sound(config), 0) == 1) { return F64_ONE; }
    if (f64_ge(frequency_hz, mesh_frequency(config)) == 1) { return 0; }

    var dt = f64_div(F64_ONE, f64_from(DwmConfig_sample_rate(config)));
    var omega_true = f64_mul(F64_TAU, frequency_hz);
    var arg = f64_div(f64_mul(f64_mul(omega_true, dt), DWM_SQRT_3), F64_TWO);
    var sin_arg = f64_clamp(f64_div(f64_sin(arg), DWM_SQRT_3), f64_neg(F64_ONE), F64_ONE);
    var omega_sim = f64_div(f64_mul(F64_TWO, f64_asin(sin_arg)), dt);
    if (f64_lt(f64_abs(omega_true), GOONJ_EPSILON) == 1) { return F64_ONE; }
    return f64_div(omega_sim, omega_true);
}

# ================================================================
# DispersionCorrection — 2-tap FIR y[n] = b0·x[n] + b1·x[n-1].
# ================================================================
#derive(accessors)
struct DispersionCorrection { b0; b1; }

# Build the 2-tap FIR correction from coefficients b0 and b1.
#must_use
fn dispersion_correction_new(b0, b1) {
    var d = alloc(sizeof(DispersionCorrection));
    DispersionCorrection_set_b0(d, b0);
    DispersionCorrection_set_b1(d, b1);
    return d;
}

# Identity filter: leaves the signal unchanged.
#must_use
fn dispersion_correction_passthrough() {
    return dispersion_correction_new(F64_ONE, 0);
}

# Calibrate so the boost at f_mesh/2 matches `boost` with unity DC gain.
#must_use
fn dispersion_correction_calibrated(config, boost) {
    var f_mesh = mesh_frequency(config);
    if (f64_le(f_mesh, 0) == 1) { return dispersion_correction_passthrough(); }
    if (DwmConfig_sample_rate(config) <= 0) { return dispersion_correction_passthrough(); }

    var omega_target = f64_div(f64_mul(F64_TAU, f64_mul(F64_HALF, f_mesh)),
      f64_from(DwmConfig_sample_rate(config)));
    var cos_t = f64_cos(omega_target);
    var denom = f64_mul(F64_TWO, f64_sub(cos_t, F64_ONE));
    if (f64_lt(f64_abs(denom), GOONJ_EPSILON) == 1) { return dispersion_correction_passthrough(); }

    var target_sq = f64_mul(boost, boost);
    var rhs = f64_div(f64_sub(target_sq, F64_ONE), denom);
    var disc = f64_sub(F64_ONE, f64_mul(f64_from(4), rhs));
    if (f64_lt(disc, 0) == 1) { return dispersion_correction_passthrough(); }
    var root = f64_sqrt(disc);
    var b0 = f64_mul(f64_add(F64_ONE, root), F64_HALF);
    return dispersion_correction_new(b0, f64_sub(F64_ONE, b0));
}

# Calibrate for `config` at the default boost, DWM_DEFAULT_BOOST.
#must_use
fn dispersion_correction_for_config(config) {
    return dispersion_correction_calibrated(config, DWM_DEFAULT_BOOST);
}

# Apply the FIR in place to a vec signal (backwards so x[i-1] survives).
fn dispersion_correction_apply(dc, signal) {
    var n = vec_len(signal);
    if (n == 0) { return 0; }
    var b0 = DispersionCorrection_b0(dc);
    var b1 = DispersionCorrection_b1(dc);
    var data = _vec_data(signal);
    var now: i64[256];
    var before: i64[256];
    # y[i] = b0·x[i] + b1·x[i-1], from the end, so x[i-1] is still the input.
    var hi = n;
    while (hi > 1) {
        var lo = hi - 256;
        if (lo < 1) { lo = 1; }
        var len = hi - lo;
        _row_scale(&now, data + lo * 8, b0, len);
        _row_scale(&before, data + (lo - 1) * 8, b1, len);
        _row_add(data + lo * 8, &now, &before, len);
        hi = lo;
    }
    vec_set(signal, 0, f64_mul(b0, vec_get(signal, 0)));
    return 0;
}

# ================================================================
# solve_dwm_3d — 3D acoustic wave equation on a box via the DWM.
# ================================================================
# Alloc a zeroed f32 buffer of `count` elements.
#must_use
fn _dwm_zeros(count) {
    return _g32_zeros(count);
}

# A run of a wall's filter state, y[n] = b0·x + a1·prev_y, updated in place from `own`, the
# outgoing waves into the wall. `len` f32 long, taken `cap` at a time: `kb0` and `ka1` are
# `cap` long and filled with b0 and a1, and `ta` and `tb` are `cap` of scratch.
fn _dwm_face_row(state, own, kb0, ka1, ta, tb, len, cap) {
    var off = 0;
    while (off < len) {
        var m = len - off;
        if (m > cap) { m = cap; }
        _row32_mul(ta, kb0, own + off * 4, m);
        _row32_mul(tb, ka1, state + off * 4, m);
        _row32_add(state + off * 4, ta, tb, m);
        off = off + m;
    }
    return 0;
}

# A BoundaryFilter's b0 and a1 as f32, each in a row of `len` for _dwm_face_row.
fn _dwm_filter_rows(filter, kb0, ka1, len) {
    _row32_fill(kb0, _g32_of(BoundaryFilter_b0(filter)), len);
    _row32_fill(ka1, _g32_of(BoundaryFilter_a1(filter)), len);
    return 0;
}

# A wall filter's output in f32, b0·x + a1·prev_y, for the x walls' scalar pass.
#must_use
fn _dwm_process32(filter, x, prev_y) {
    var b0 = _g32_of(BoundaryFilter_b0(filter));
    var a1 = _g32_of(BoundaryFilter_a1(filter));
    return _g32_add(_g32_mul(b0, x), _g32_mul(a1, prev_y));
}

# The junction update over `len` consecutive nodes from node `first`, in Rust's order
# (rust-old/src/dwm.rs:493): p = (2/K)·(((((xp + xn) + yp) + yn) + zp) + zn), then
# out_i = p − in_i. `o` and `q` are this step's and the next step's ports, each `n` long;
# in_yp to in_zn point at node `first`'s incoming wave along that axis.
fn _dwm_stencil(o, q, n, first, len, in_yp, in_yn, in_zp, in_zn, pressure, k_scatter, t_sum) {
    var off = first * 4;
    var in_xp = o + n * 4 + off + 4;   # port 1 (-x) of the node after
    var in_xn = o + off - 4;           # port 0 (+x) of the node before
    var p_row = pressure + off;
    _row32_add(t_sum, in_xp, in_xn, len);
    _row32_add(t_sum, t_sum, in_yp, len);
    _row32_add(t_sum, t_sum, in_yn, len);
    _row32_add(t_sum, t_sum, in_zp, len);
    _row32_add(t_sum, t_sum, in_zn, len);
    _row32_mul(p_row, k_scatter, t_sum, len);
    _row32_sub(q + off, p_row, in_xp, len);
    _row32_sub(q + n * 4 + off, p_row, in_xn, len);
    _row32_sub(q + 2 * n * 4 + off, p_row, in_yp, len);
    _row32_sub(q + 3 * n * 4 + off, p_row, in_yn, len);
    _row32_sub(q + 4 * n * 4 + off, p_row, in_zp, len);
    _row32_sub(q + 5 * n * 4 + off, p_row, in_zn, len);
    return 0;
}

# Returns a DwmResult. Empty result on degenerate input (tiny grid, source
# out of range, dx deviating from c·Δt·√3 by >10%, etc.). `receivers` is a
# vec of DwmReceiver; each in-range receiver gets a pressure trace. Runs in f32,
# as Rust's did (ADR-0010).
#must_use
fn solve_dwm_3d(config, source, receivers) {
    # Rust's DwmConfig holds these as f32, so every test and step below sees them so.
    var dx = _g32_of(DwmConfig_dx(config));
    var speed = _g32_of(DwmConfig_speed_of_sound(config));
    var duration = _g32_of(DwmConfig_duration_seconds(config));
    if (DwmConfig_sample_rate(config) == 0) { return _dwm_empty_result(); }
    if (f64_le(_g32_wide(dx), 0) == 1) { return _dwm_empty_result(); }
    if (f64_le(_g32_wide(speed), 0) == 1) { return _dwm_empty_result(); }
    var nx = DwmConfig_nx(config);
    var ny = DwmConfig_ny(config);
    var nz = DwmConfig_nz(config);
    if (nx < 3) { return _dwm_empty_result(); }
    if (ny < 3) { return _dwm_empty_result(); }
    if (nz < 3) { return _dwm_empty_result(); }
    if (f64_le(_g32_wide(duration), 0) == 1) { return _dwm_empty_result(); }

    # Rust chained saturating_mul (rust-old/src/dwm.rs:343-347). Stage the
    # product and bound each intermediate so no multiply can wrap past the cap
    # (nx=4, ny=4, nz=2^60+1 wrapped to 16 and slipped both guards).
    if (nx > DWM_MAX_GRID_CELLS) { return _dwm_empty_result(); }
    if (ny > DWM_MAX_GRID_CELLS) { return _dwm_empty_result(); }
    if (nz > DWM_MAX_GRID_CELLS) { return _dwm_empty_result(); }
    var nxy = nx * ny;
    if (nxy > DWM_MAX_GRID_CELLS) { return _dwm_empty_result(); }
    var n = nxy * nz;
    if (n <= 0) { return _dwm_empty_result(); }
    if (n > DWM_MAX_GRID_CELLS) { return _dwm_empty_result(); }
    # DwmSource.ix/iy/iz were `usize` in Rust (rust-old/src/dwm.rs:251-255);
    # signed i64 loses the lower bound, and _dwm_idx would address before the
    # node buffers.
    if (DwmSource_ix(source) < 0) { return _dwm_empty_result(); }
    if (DwmSource_iy(source) < 0) { return _dwm_empty_result(); }
    if (DwmSource_iz(source) < 0) { return _dwm_empty_result(); }
    if (DwmSource_ix(source) >= nx) { return _dwm_empty_result(); }
    if (DwmSource_iy(source) >= ny) { return _dwm_empty_result(); }
    if (DwmSource_iz(source) >= nz) { return _dwm_empty_result(); }

    # dt, the expected dx and the deviation, in f32 (rust-old/src/dwm.rs:356-358).
    var dt = _g32_div(G32_ONE, _g32_int(DwmConfig_sample_rate(config)));
    var dx_expected = _g32_mul(_g32_mul(speed, dt), _g32_of(DWM_SQRT_3_F32));
    var dx_off = _g32_sub(dx, dx_expected) & 0x7FFFFFFF;   # f32::abs
    var dx_dev = _g32_wide(_g32_div(dx_off, _g32_max(dx_expected, G32_EPSILON)));
    if (f64_gt(dx_dev, DWM_DX_FAIL_TOL) == 1) {
        # Ports the Rust tracing::warn! — surfaced via goonj_log (verbose diag).
        goonj_log_warn("dwm: dx deviates from c*dt*sqrt(3) by >10%; refusing to run");
        return _dwm_empty_result();
    }
    if (f64_gt(dx_dev, DWM_DX_WARN_TOL) == 1) {
        goonj_log_warn("dwm: dx deviates from c*dt*sqrt(3) by >1%; sound speed will be off");
    }

    # Rust: `(duration / dt) as u32` then `.min(MAX)`, the division in f32. The `as` cast
    # SATURATES — NaN and negatives to 0, overflow to u32::MAX — so a huge duration runs the
    # CAP. Before cyrius 6.6.8 f64_to gave INT64_MIN there, which is neither
    # > MAX nor == 0, so the step loop silently ran ZERO times. Clamp in f64
    # first: f64_to saturates now, but it still keeps the sign (ADR-0003).
    var steps_f = _g32_wide(_g32_div(duration, dt));
    var num_steps = 0;
    if (f64_ge(steps_f, f64_from(DWM_MAX_TIME_STEPS)) == 1) { num_steps = DWM_MAX_TIME_STEPS; }
    if (f64_gt(steps_f, 0) == 1) {
        if (f64_lt(steps_f, f64_from(DWM_MAX_TIME_STEPS)) == 1) { num_steps = f64_to(steps_f); }
    }
    if (num_steps == 0) { return _dwm_empty_result(); }

    var walls = DwmConfig_wall_materials(config);
    var f_xneg = boundary_filter_from_material(WallMaterials_x_neg(walls));
    var f_xpos = boundary_filter_from_material(WallMaterials_x_pos(walls));
    var f_yneg = boundary_filter_from_material(WallMaterials_y_neg(walls));
    var f_ypos = boundary_filter_from_material(WallMaterials_y_pos(walls));
    var f_zneg = boundary_filter_from_material(WallMaterials_z_neg(walls));
    var f_zpos = boundary_filter_from_material(WallMaterials_z_pos(walls));

    # Per-face IIR filter state (one f32 per boundary cell).
    var s_xneg = _dwm_zeros(ny * nz);
    var s_xpos = _dwm_zeros(ny * nz);
    var s_yneg = _dwm_zeros(nx * nz);
    var s_ypos = _dwm_zeros(nx * nz);
    var s_zneg = _dwm_zeros(nx * ny);
    var s_zpos = _dwm_zeros(nx * ny);

    # Outgoing-wave buffers (K per node), pressure scratch.
    var out_curr = _dwm_zeros(n * DWM_K);
    var out_next = _dwm_zeros(n * DWM_K);
    var pressure = _dwm_zeros(n);

    # One accumulator vec per receiver (out-of-range ones stay empty).
    var receiver_signals = vec_new();
    var ri = 0;
    while (ri < vec_len(receivers)) {
        vec_push(receiver_signals, vec_new());
        ri = ri + 1;
    }

    var source_signal = DwmSource_signal(source);
    var source_len = vec_len(source_signal);
    var source_node = _dwm_idx(DwmSource_ix(source), DwmSource_iy(source), DwmSource_iz(source), nx, ny);
    var source_row = source_node - DwmSource_ix(source);
    var scatter: f32 = _g32_of(DWM_SCATTER);
    var xneg_b0: f32 = _g32_of(BoundaryFilter_b0(f_xneg));
    var xneg_a1: f32 = _g32_of(BoundaryFilter_a1(f_xneg));
    var xpos_b0: f32 = _g32_of(BoundaryFilter_b0(f_xpos));
    var xpos_a1: f32 = _g32_of(BoundaryFilter_a1(f_xpos));
    var source_f32: f32 = 0;

    # Each port is its own array of `n`, so a row of nodes is a run of memory and the
    # stencil can be array ops (ADR-0008). Ports 0 to 5 point +x, -x, +y, -y, +z, -z.
    # A node's incoming wave along each axis is its neighbour's opposite port, or at a
    # wall its own outgoing wave through that face's filter.
    # Interior rows run in chunks of whole rows, `cap` elements of scratch (ADR-0010).
    var inner = nx - 2;
    var rows = _row32_rows_per_chunk(nx);
    var cap = rows * nx;
    var t_sum = _dwm_zeros(cap);
    var t_other = _dwm_zeros(cap);
    var k_scatter = _dwm_zeros(cap);
    _row32_fill(k_scatter, _g32_of(DWM_SCATTER), cap);
    var kb0_ypos = _dwm_zeros(cap);
    var ka1_ypos = _dwm_zeros(cap);
    var kb0_yneg = _dwm_zeros(cap);
    var ka1_yneg = _dwm_zeros(cap);
    var kb0_zpos = _dwm_zeros(cap);
    var ka1_zpos = _dwm_zeros(cap);
    var kb0_zneg = _dwm_zeros(cap);
    var ka1_zneg = _dwm_zeros(cap);
    _dwm_filter_rows(f_ypos, kb0_ypos, ka1_ypos, cap);
    _dwm_filter_rows(f_yneg, kb0_yneg, ka1_yneg, cap);
    _dwm_filter_rows(f_zpos, kb0_zpos, ka1_zpos, cap);
    _dwm_filter_rows(f_zneg, kb0_zneg, ka1_zneg, cap);

    for (var step = 0; step < num_steps; step = step + 1) {
        var o0 = out_curr;
        var o1 = o0 + n * 4;
        var o2 = o1 + n * 4;
        var o3 = o2 + n * 4;
        var o4 = o3 + n * 4;
        var o5 = o4 + n * 4;
        var q0 = out_next;
        var q1 = q0 + n * 4;
        var q2 = q1 + n * 4;
        var q3 = q2 + n * 4;
        var q4 = q3 + n * 4;
        var q5 = q4 + n * 4;
        var source_on = 0;
        if (step < source_len) {
            source_on = 1;
            source_f32 = _g32_of(vec_get(source_signal, step));   # Rust's signal is f32
        }

        for (var z = 0; z < nz; z = z + 1) {
            var plane = z * nxy;

            # A z wall's filter state is one plane, so a wall plane updates all of it first.
            if (z == nz - 1) {
                _dwm_face_row(s_zpos, o4 + plane * 4, kb0_zpos, ka1_zpos, t_sum, t_other, nxy, cap);
            }
            if (z == 0) {
                _dwm_face_row(s_zneg, o5 + plane * 4, kb0_zneg, ka1_zneg, t_sum, t_other, nxy, cap);
            }

            # Rows 0 and ny - 1 meet a y wall: that row of the face's state, then the row's
            # nodes x = 1 to nx - 2.
            for (var yw = 0; yw < 2; yw = yw + 1) {
                var y = 0;
                if (yw == 1) { y = ny - 1; }
                var row = plane + y * nx;
                var f = row + 1;
                var in_yp = o3 + (f + nx) * 4;
                var in_yn = o2 + (f - nx) * 4;
                if (y == ny - 1) {
                    _dwm_face_row(s_ypos + z * nx * 4, o2 + row * 4, kb0_ypos, ka1_ypos, t_sum, t_other, nx, cap);
                    in_yp = s_ypos + (z * nx + 1) * 4;
                }
                if (y == 0) {
                    _dwm_face_row(s_yneg + z * nx * 4, o3 + row * 4, kb0_yneg, ka1_yneg, t_sum, t_other, nx, cap);
                    in_yn = s_yneg + (z * nx + 1) * 4;
                }
                var in_zp = o5 + (f + nxy) * 4;
                if (z == nz - 1) { in_zp = s_zpos + (y * nx + 1) * 4; }
                var in_zn = o4 + (f - nxy) * 4;
                if (z == 0) { in_zn = s_zneg + (y * nx + 1) * 4; }
                _dwm_stencil(o0, q0, n, f, inner, in_yp, in_yn, in_zp, in_zn, pressure, k_scatter, t_sum);
            }

            # Rows 1 to ny - 2 in chunks of whole rows, each one span from (1, y0) to
            # (nx - 2, y1). A span takes in the x = 0 and x = nx - 1 nodes between its rows
            # too, with the wrong x neighbours, and the pass below computes every one of them
            # again (ADR-0010).
            var y0 = 1;
            while (y0 < ny - 1) {
                var y1 = y0 + rows - 1;
                if (y1 > ny - 2) { y1 = ny - 2; }
                var sf = plane + y0 * nx + 1;
                var len = (y1 - y0 + 1) * nx - 2;
                var sp_zp = o5 + (sf + nxy) * 4;
                if (z == nz - 1) { sp_zp = s_zpos + (y0 * nx + 1) * 4; }
                var sp_zn = o4 + (sf - nxy) * 4;
                if (z == 0) { sp_zn = s_zneg + (y0 * nx + 1) * 4; }
                _dwm_stencil(o0, q0, n, sf, len, o3 + (sf + nx) * 4, o2 + (sf - nx) * 4, sp_zp, sp_zn,
                  pressure, k_scatter, t_sum);
                y0 = y1 + 1;
            }

            # Each row's two end nodes have an x wall, so one scalar pass each, and the
            # source joins its node here if it sits inside the row.
            for (var y = 0; y < ny; y = y + 1) {
                var row = plane + y * nx;
                # Incoming along y and z, as pointers to x = 0 of this row.
                var in_yp = o3 + (row + nx) * 4;
                if (y == ny - 1) { in_yp = s_ypos + (z * nx) * 4; }
                var in_yn = o2 + (row - nx) * 4;
                if (y == 0) { in_yn = s_yneg + (z * nx) * 4; }
                var in_zp = o5 + (row + nxy) * 4;
                if (z == nz - 1) { in_zp = s_zpos + (y * nx) * 4; }
                var in_zn = o4 + (row - nxy) * 4;
                if (z == 0) { in_zn = s_zneg + (y * nx) * 4; }

                var si = z * ny + y;
                var e = 0;
                while (e < 3) {
                    var x = 0;
                    var do_node = 1;
                    if (e == 1) { x = nx - 1; }
                    if (e == 2) {
                        x = source_node - row;
                        do_node = 0;
                        if (source_on == 1) {
                            if (row == source_row) {
                                if (x > 0) {
                                    if (x < nx - 1) { do_node = 1; }
                                }
                            }
                        }
                    }
                    if (do_node == 1) {
                        # Typed f32 locals, so each + - * below is one f32 operation, inline.
                        var node = row + x;
                        var xp: f32 = 0;
                        var xn: f32 = 0;
                        if (e == 0) {
                            var own_xn: f32 = load32(o1 + node * 4);
                            var prev_xn: f32 = load32(s_xneg + si * 4);
                            xn = xneg_b0 * own_xn + xneg_a1 * prev_xn;
                            store32(s_xneg + si * 4, xn);
                        } else {
                            xn = load32(o0 + (node - 1) * 4);
                        }
                        if (e == 1) {
                            var own_xp: f32 = load32(o0 + node * 4);
                            var prev_xp: f32 = load32(s_xpos + si * 4);
                            xp = xpos_b0 * own_xp + xpos_a1 * prev_xp;
                            store32(s_xpos + si * 4, xp);
                        } else {
                            xp = load32(o1 + (node + 1) * 4);
                        }
                        var yp: f32 = load32(in_yp + x * 4);
                        var yn: f32 = load32(in_yn + x * 4);
                        var zp: f32 = load32(in_zp + x * 4);
                        var zn: f32 = load32(in_zn + x * 4);

                        # Rust's order: ((((xp + xn) + yp) + yn) + zp) + zn.
                        var sum: f32 = xp + xn;
                        sum = sum + yp;
                        sum = sum + yn;
                        sum = sum + zp;
                        sum = sum + zn;
                        var p: f32 = scatter * sum;

                        # Transparent (additive) source injection.
                        if (node == source_node) {
                            if (source_on == 1) { p = p + source_f32; }
                        }
                        store32(pressure + node * 4, p);
                        store32(q0 + node * 4, p - xp);
                        store32(q1 + node * 4, p - xn);
                        store32(q2 + node * 4, p - yp);
                        store32(q3 + node * 4, p - yn);
                        store32(q4 + node * 4, p - zp);
                        store32(q5 + node * 4, p - zn);
                    }
                    e = e + 1;
                }
            }
        }

        # Sample receivers.
        for (var rj = 0; rj < vec_len(receivers); rj = rj + 1) {
            var rx = vec_get(receivers, rj);
            # DwmReceiver.ix/iy/iz were `usize` in Rust (rust-old/src/dwm.rs:289-293);
            # a negative index passed the `<` half and read outside the field.
            var rix = DwmReceiver_ix(rx);
            var riy = DwmReceiver_iy(rx);
            var riz = DwmReceiver_iz(rx);
            var in_range = 1;
            if (rix < 0) { in_range = 0; }
            if (riy < 0) { in_range = 0; }
            if (riz < 0) { in_range = 0; }
            if (rix >= nx) { in_range = 0; }
            if (riy >= ny) { in_range = 0; }
            if (riz >= nz) { in_range = 0; }
            if (in_range == 1) {
                var pidx = _dwm_idx(rix, riy, riz, nx, ny);
                vec_push(vec_get(receiver_signals, rj), _g32_wide(load32(pressure + pidx * 4)));
            }
        }

        # Rotate buffers.
        var tmp = out_curr;
        out_curr = out_next;
        out_next = tmp;
    }

    var result = alloc(sizeof(DwmResult));
    DwmResult_set_receiver_signals(result, receiver_signals);
    DwmResult_set_final_pressure(result, _g32_to_vec(pressure, n));
    DwmResult_set_time_steps(result, num_steps);
    DwmResult_set_dt(result, _g32_wide(dt));
    return result;
}
