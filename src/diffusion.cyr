# diffusion.cyr -- acoustic diffusion equation (ADE) energy-density PDE
# solver. Models sound energy density as a diffusion process (Fick's law
# analogy) for high-frequency diffuse fields: long rooms, coupled rooms,
# and industrial spaces where ray tracing struggles.
#
# Ports rust-old/src/diffusion.rs. The solver runs in f32, as Rust's did (ADR-0010), so
# on the same input it gives Rust's bits. Rust's `serde` derive is dropped (no serde in
# Cyrius); the serde round-trip test is omitted. Rust's `Vec<f32>` energy field -> stdlib
# `vec` of f64s holding f32 values; the `&[f32]` absorption/source slices -> a raw f64
# buffer pointer plus an element count, each value rounded to f32; the `[usize; 2]`
# dimensions -> two scalar fields.
#
# Requires (from the build/test unit): stdlib math (f64_* + F64_*),
# vec (vec_new/push/len/get/set), alloc (alloc_init must have run).
#
# Reference: Valeau et al., "On the use of a diffusion equation for
# room-acoustic prediction," JASA 119(3), 2006.

# Configuration for the acoustic diffusion equation solver. Fields:
# dx (grid spacing m), dt (time step s), nx/ny (grid cells), speed_of_sound
# (m/s), mean_free_path (m, ~ 4V/S), max_time (simulation duration s).
#derive(accessors)
struct DiffusionConfig {
    dx;
    dt;
    nx;
    ny;
    speed_of_sound;
    mean_free_path;
    max_time;
}

# Build a DiffusionConfig for an nx x ny grid with spacing dx and time step dt.
#must_use
fn diffusion_config_new(dx, dt, nx, ny, speed_of_sound, mean_free_path, max_time) {
    var c = alloc(sizeof(DiffusionConfig));
    DiffusionConfig_set_dx(c, dx);
    DiffusionConfig_set_dt(c, dt);
    DiffusionConfig_set_nx(c, nx);
    DiffusionConfig_set_ny(c, ny);
    DiffusionConfig_set_speed_of_sound(c, speed_of_sound);
    DiffusionConfig_set_mean_free_path(c, mean_free_path);
    DiffusionConfig_set_max_time(c, max_time);
    return c;
}

# Result of a diffusion simulation. `energy_density` is a vec of n f64
# (flattened, [y * nx + x]); dimensions = (dim_x, dim_y).
#derive(accessors)
struct DiffusionResult { energy_density; dim_x; dim_y; time_steps; dx; }

#must_use
fn _diff_result_new(energy_density, dim_x, dim_y, time_steps, dx) {
    var r = alloc(sizeof(DiffusionResult));
    DiffusionResult_set_energy_density(r, energy_density);
    DiffusionResult_set_dim_x(r, dim_x);
    DiffusionResult_set_dim_y(r, dim_y);
    DiffusionResult_set_time_steps(r, time_steps);
    DiffusionResult_set_dx(r, dx);
    return r;
}

# usize::clamp(v, 3, 2000) — cap grid size to prevent OOM (~4M cells max).
fn _diff_clamp_grid(v) {
    if (v < 3) { return 3; }
    if (v > 2000) { return 2000; }
    return v;
}

# A fresh vec of `n` zeros (f64 +0.0 shares integer 0's bit pattern).
fn _diff_zeros(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(v, 0);
        i = i + 1;
    }
    return v;
}

# Solve the 2D acoustic diffusion equation on a regular grid using
# explicit finite differences (FTCS):
#   dw/dt = D*lap(w) - c/lambda * alpha * w + S(x,t),
#   D = c*lambda/3 (diffusion coefficient), lambda = mean free path.
# absorption_field / source_field are raw f64 buffers of `*_len` elems
# (pass 0/0 for an empty slice). Returns a DiffusionResult pointer.
# Runs in f32, as Rust's did (ADR-0010): the config and each field value are rounded to
# f32 on the way in, and the energy comes back as f64s of f32 values.
#must_use
fn solve_diffusion_2d(config, absorption_field, absorption_len, source_field, source_len) {
    # Rust's DiffusionConfig holds these as f32, so every test and step below sees them so.
    var dx = _g32_of(DiffusionConfig_dx(config));
    var nx = _diff_clamp_grid(DiffusionConfig_nx(config));
    var ny = _diff_clamp_grid(DiffusionConfig_ny(config));
    var n = nx * ny;

    var c = _g32_of(DiffusionConfig_speed_of_sound(config));
    var mfp = _g32_of(DiffusionConfig_mean_free_path(config));
    var dt_cfg = _g32_of(DiffusionConfig_dt(config));

    # Invalid config: any non-positive dx/dt/mfp/speed -> empty result.
    var bad = 0;
    if (f64_le(_g32_wide(dx), 0) == 1) { bad = 1; }
    if (f64_le(_g32_wide(dt_cfg), 0) == 1) { bad = 1; }
    if (f64_le(_g32_wide(mfp), 0) == 1) { bad = 1; }
    if (f64_le(_g32_wide(c), 0) == 1) { bad = 1; }
    if (bad == 1) {
        return _diff_result_new(_diff_zeros(n), nx, ny, 0, _g32_wide(dx));
    }

    # In f32 and in Rust's order (rust-old/src/diffusion.rs:83-90).
    var d_coeff = _g32_div(_g32_mul(c, mfp), _g32_of(f64_from(3)));   # diffusion coefficient
    var dx2 = _g32_mul(dx, dx);

    # Stability: dt < dx^2 / (4 D) for the 2D explicit scheme; use 0.9 of it. f32::min
    # ignores a NaN.
    var dt_max = _g32_div(dx2, _g32_mul(G32_FOUR, d_coeff));
    var dt_cap = _g32_mul(dt_max, _g32_of(f64_div(f64_from(9), f64_from(10))));
    var dt = _g32_of(goonj_fmin(_g32_wide(dt_cfg), _g32_wide(dt_cap)));
    # Rust: `(max_time / dt) as u32` then `.min(1_000_000)` — a saturating cast,
    # so a negative or NaN max_time yields 0 steps (and time_steps: 0 in the
    # result) while a huge one runs the cap. f64_to keeps the sign, so a negative
    # max_time was reported verbatim as a negative time_steps, and it overflowed
    # to INT64_MIN before cyrius 6.6.8 (ADR-0003). Unlike fdtd/dwm this must NOT
    # early-return: Rust falls through
    # and returns a normal result with time_steps = 0.
    var steps_f = _g32_wide(_g32_div(_g32_of(DiffusionConfig_max_time(config)), dt));
    var num_steps = 0;
    if (f64_ge(steps_f, f64_from(1000000)) == 1) { num_steps = 1000000; }
    if (f64_gt(steps_f, 0) == 1) {
        if (f64_lt(steps_f, f64_from(1000000)) == 1) { num_steps = f64_to(steps_f); }
    }

    var w = _g32_zeros(n);       # energy density
    var w_new = _g32_zeros(n);

    # Initialize source (take at most n elements).
    var lim = source_len;
    if (lim > n) { lim = n; }
    var si = 0;
    while (si < lim) {
        store32(w + si * 4, _g32_of(load64(source_field + si * 8)));
        si = si + 1;
    }

    var ratio = _g32_div(_g32_mul(d_coeff, dt), dx2);
    var c_over_mfp = _g32_div(c, mfp);

    # The absorption rate per cell, (c / mfp) * alpha (alpha is 0 beyond the supplied field).
    var loss = _g32_zeros(n);
    var li = 0;
    while (li < n) {
        var alpha = 0;
        if (li < absorption_len) { alpha = _g32_of(load64(absorption_field + li * 8)); }
        store32(loss + li * 4, _g32_mul(c_over_mfp, alpha));
        li = li + 1;
    }

    # The interior runs in chunks of whole rows, each one span from (1, y0) to (nx - 2, y1) in
    # row-major order, into scratch. The x = 0 and x = nx - 1 cells between those rows come
    # out wrong, and only each row's interior is copied back, so the boundary keeps what
    # Rust's keeps (ADR-0010). Scratch for the f32 kernels, and the scalars they multiply by.
    var inner = nx - 2;
    var rows = _row32_rows_per_chunk(nx);
    var cap = rows * nx;
    var t_new = _g32_zeros(cap);
    var t_loss = _g32_zeros(cap);
    var k_four = _g32_zeros(cap);
    var k_ratio = _g32_zeros(cap);
    var k_dt = _g32_zeros(cap);
    _row32_fill(k_four, G32_FOUR, cap);
    _row32_fill(k_ratio, ratio, cap);
    _row32_fill(k_dt, dt, cap);

    var step = 0;
    while (step < num_steps) {
        var y0 = 1;
        while (y0 < ny - 1) {
            var y1 = y0 + rows - 1;
            if (y1 > ny - 2) { y1 = ny - 2; }
            var first = (y0 * nx + 1) * 4;
            var len = (y1 - y0 + 1) * nx - 2;
            # wn = (wc + ratio * lap) - dt * (loss * wc), where
            # lap = (((left + right) + below) + above) - 4 * wc, as Rust ordered them
            # (rust-old/src/diffusion.rs:103-113).
            var wc = w + first;
            _row32_add(t_new, wc - 4, wc + 4, len);
            _row32_add(t_new, t_new, wc - nx * 4, len);
            _row32_add(t_new, t_new, wc + nx * 4, len);
            _row32_mul(t_loss, k_four, wc, len);
            _row32_sub(t_new, t_new, t_loss, len);
            _row32_mul(t_new, k_ratio, t_new, len);
            _row32_add(t_new, wc, t_new, len);
            _row32_mul(t_loss, loss + first, wc, len);
            _row32_mul(t_loss, k_dt, t_loss, len);
            _row32_sub(t_new, t_new, t_loss, len);

            # Each row's interior, through Rust's `.max(0.0)`, which also takes NaN to 0. An
            # f32 stays only if it is positive and not NaN: 0 < bits <= +inf's.
            var y = y0;
            while (y <= y1) {
                var src = t_new + (y - y0) * nx * 4;
                var out = w_new + (y * nx + 1) * 4;
                var x = 0;
                while (x < inner) {
                    var b = load32(src + x * 4) & 0xFFFFFFFF;
                    if (b > 0x7F800000) { b = 0; }
                    store32(out + x * 4, b);
                    x = x + 1;
                }
                y = y + 1;
            }
            y0 = y1 + 1;
        }
        # std::mem::swap(&mut w, &mut w_new)
        var tmp = w;
        w = w_new;
        w_new = tmp;
        step = step + 1;
    }

    return _diff_result_new(_g32_to_vec(w, n), nx, ny, num_steps, _g32_wide(dx));
}
