# hardening.tcyr -- regression suite for the 2.0.2 P-1 hardening pass.
#
# Every case here is a defect that was REPRODUCED against 2.0.1 (most as a
# SIGSEGV or a hard process abort) and is now expected to return a degenerate
# result instead. They share one root cause: the Rust oracle typed its indices
# and extents `usize`/`u32`, so non-negativity and saturating float->int casts
# came free from the type system. The Cyrius port carries all of them as signed
# i64, and `f64_to` did not saturate until cyrius 6.6.8, so every guard that Rust
# wrote as a single upper-bound test lost its lower half.
#
# Run: cyrius test tests/hardening.tcyr
#
# Tests the SHIPPED bundle (same posture as bundle.tcyr), so it also proves the
# repairs reached dist/goonj.cyr.
include "lib/hisab.cyr"
include "lib/sakshi.cyr"
include "dist/goonj.cyr"

fn _h_pct(n) { return f64_div(f64_from(n), f64_from(100)); }
fn _h_nan() { return f64_div(f64_from(0), f64_from(0)); }
fn _h_inf() { return f64_div(f64_from(1), f64_from(0)); }

fn _h_sig1() {
    var v = vec_new();
    vec_push(v, F64_ONE);
    return v;
}

# ================================================================
# fdtd -- negative source/receiver indices, and the cell-cap overflow.
# 2.0.1: each of these exited 139 (SIGSEGV).
# ================================================================
fn _h_fdtd() {
    test_group("fdtd: negative indices and cap overflow are rejected");

    var cfg = fdtd_config_new(22050, _h_pct(5), f64_from(343), 40, 40, _h_pct(1));

    # Negative source index: passed `>= nx` and stored before the grid buffer.
    var r1 = solve_fdtd_2d(cfg, fdtd_source_new(0 - 100000000, 0, _h_sig1()), vec_new());
    assert_eq(FdtdResult_time_steps(r1), 0, "fdtd negative source ix -> empty result");

    var r2 = solve_fdtd_2d(cfg, fdtd_source_new(0, 0 - 7, _h_sig1()), vec_new());
    assert_eq(FdtdResult_time_steps(r2), 0, "fdtd negative source iy -> empty result");

    # Negative receiver index: passed `< nx` and read outside the field.
    var recv = vec_new();
    vec_push(recv, fdtd_receiver_new(0 - 100000000, 0));
    var r3 = solve_fdtd_2d(cfg, fdtd_source_new(1, 1, _h_sig1()), recv);
    var tr = vec_get(FdtdResult_receiver_signals(r3), 0);
    assert_eq(vec_len(tr), 0, "fdtd negative receiver -> silent (empty) trace");

    # nx * ny wrapped past MAX_GRID_CELLS: 4 * (2^62+1) == 4 (mod 2^64).
    var big = fdtd_config_new(22050, _h_pct(5), f64_from(343), 4, 4611686018427387905, _h_pct(1));
    var r4 = solve_fdtd_2d(big, fdtd_source_new(1, 1, _h_sig1()), vec_new());
    assert_eq(FdtdResult_time_steps(r4), 0, "fdtd nx*ny overflow -> empty result");

    # A valid solve still works (the guards must not over-reject).
    var ok = solve_fdtd_2d(cfg, fdtd_source_new(20, 20, _h_sig1()), vec_new());
    assert_gt(FdtdResult_time_steps(ok), 0, "fdtd valid config still solves");
    return 0;
}

# ================================================================
# dwm -- negative receiver indices and the 3-way cap overflow.
# ================================================================
fn _h_dwm() {
    test_group("dwm: negative indices and cap overflow are rejected");

    var dx = f64_mul(f64_div(f64_from(343), f64_from(22050)), DWM_SQRT_3);
    var cfg = dwm_config_new(22050, dx, f64_from(343), 6, 6, 6, _h_pct(1), wall_materials_rigid());
    var src = dwm_source_gaussian_pulse(1, 1, 1, 4, f64_from(2), F64_ONE);

    var recv = vec_new();
    vec_push(recv, dwm_receiver_new(0 - 100000000, 1, 1));
    var r1 = solve_dwm_3d(cfg, src, recv);
    var tr = vec_get(DwmResult_receiver_signals(r1), 0);
    assert_eq(vec_len(tr), 0, "dwm negative receiver -> silent (empty) trace");

    # Negative source index.
    var r2 = solve_dwm_3d(cfg, dwm_source_gaussian_pulse(0 - 5, 1, 1, 4, f64_from(2), F64_ONE), vec_new());
    assert_eq(DwmResult_time_steps(r2), 0, "dwm negative source -> empty result");

    # nx*ny*nz wrapped: 4 * 4 * (2^60+1) == 16 (mod 2^64).
    var big = dwm_config_new(22050, dx, f64_from(343), 4, 4, 1152921504606846977,
      _h_pct(1), wall_materials_rigid());
    var r3 = solve_dwm_3d(big, dwm_source_gaussian_pulse(1, 1, 1, 4, f64_from(2), F64_ONE), vec_new());
    assert_eq(DwmResult_time_steps(r3), 0, "dwm nx*ny*nz overflow -> empty result");
    return 0;
}

# ================================================================
# material -- Rust rejects NaN via !(0.0..=1.0).contains(); the port's
# two one-sided rejections accepted it.
# ================================================================
fn _h_material() {
    test_group("material: NaN coefficients are rejected");

    var bands = alloc(NUM_BANDS * 8);
    var i = 0;
    while (i < NUM_BANDS) {
        store64(bands + i * 8, _h_pct(10));
        i = i + 1;
    }
    var good = acoustic_material_new("ok", bands, F64_HALF);
    assert_neq(good, 0, "valid material still accepted");

    store64(bands + 3 * 8, _h_nan());
    assert_eq(acoustic_material_new("nanabs", bands, F64_HALF), 0,
      "NaN absorption band rejected");

    store64(bands + 3 * 8, _h_pct(10));
    assert_eq(acoustic_material_new("nanscat", bands, _h_nan()), 0,
      "NaN scattering rejected");

    # The existing range rejections must still hold.
    assert_eq(acoustic_material_new("hiscat", bands, f64_from(2)), 0,
      "scattering > 1 still rejected");
    return 0;
}

# ================================================================
# metamaterial -- an odd-length flattened (freq, abs) vec read index 1
# out of bounds and aborted the process.
# ================================================================
fn _h_metamaterial() {
    test_group("metamaterial: odd-length lookup rows do not abort");

    var rows = mm_rows_new();
    vec_push(rows, f64_from(500));
    var m = metamaterial_lookup_table(rows);
    assert_eq(metamaterial_absorption_at(m, f64_from(500)), 0,
      "odd-length lookup rows -> 0, no abort");

    var ok = mm_rows_new();
    mm_rows_push(ok, f64_from(500), F64_HALF);
    var m2 = metamaterial_lookup_table(ok);
    assert_eq(metamaterial_absorption_at(m2, f64_from(500)), F64_HALF,
      "well-formed single row still looks up");
    return 0;
}

# ================================================================
# analysis -- a negative sample_rate produced a negative vec index and
# killed the host process inside vec_get.
# ================================================================
fn _h_analysis() {
    test_group("analysis: negative sample_rate does not abort");

    var samples = vec_new();
    var i = 0;
    while (i < 1000) {
        vec_push(samples, F64_ONE);
        i = i + 1;
    }
    var ir = impulse_response_new(samples, 0 - 48000, F64_ONE);
    assert_eq(clarity_c50(ir), 0, "clarity_c50 with negative rate -> 0");
    assert_eq(clarity_c80(ir), 0, "clarity_c80 with negative rate -> 0");
    return 0;
}

# ================================================================
# propagation -- f64_to did not saturate before cyrius 6.6.8, so an
# infinite/huge max_distance made max_iter INT64_MIN and returned a 1-point path.
# ================================================================
fn _h_propagation() {
    test_group("propagation: non-finite max_distance saturates like Rust");

    # wind/temp are profile handles, not raw values.
    var wcalm = wind_profile_new(hvec3_unit_x(), 0, 0);
    var tflat = temperature_profile_new(f64_from(20), 0);
    var src = hvec3_new(0, f64_from(10), 0);

    # Rust: `(max_distance / step.max(0.001)) as u32` saturates to u32::MAX, then
    # .min(1_000_000). 2.0.1 returned a 1-point path instead (INT64_MIN max_iter).
    var p1 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, _h_inf(), F64_ONE);
    assert_eq(vec_len(p1), 1000001, "+inf max_distance -> 1000001 points, not 1");

    # 1e19 (> i64::MAX: past f64_to's range, whichever way it fails).
    var huge = f64_mul(f64_from(1000000000), f64_from(10000000000));
    var p2 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, huge, F64_ONE);
    assert_eq(vec_len(p2), 1000001, "1e19 max_distance -> 1000001 points, not 1");

    # NaN must match Rust's `NaN as u32 == 0`: no steps.
    var p3 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, _h_nan(), F64_ONE);
    assert_eq(vec_len(p3), 1, "NaN max_distance -> source-only path (Rust parity)");

    # A normal trace is unaffected.
    var p4 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, f64_from(100), F64_ONE);
    assert_gt(vec_len(p4), 1, "ordinary trace still works");
    return 0;
}

# ================================================================
# impulse / binaural -- Rust's `as usize` cast SATURATES (NaN and
# negatives to 0, overflow to usize::MAX). Cyrius f64_to keeps the sign,
# so the sample-count clamp has to happen in f64. Mapping the INT64_MIN
# sentinel to max_samples instead (as 2.0.2 first did) turns Rust's
# no-op into an 8 x 115.2M x 8 B ~= 7.4 GB allocation.
# ================================================================
fn _h_ir_sample_count() {
    test_group("impulse/binaural: non-finite max_time yields an empty IR, not 7.4 GB");

    var mat = acoustic_material_concrete();
    var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), mat);
    var src = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
    var lis = hvec3_new(f64_from(5), F64_ONE, f64_from(2));

    # Negative max_time: Rust saturates to 0 samples.
    var neg = ir_config_new(48000, 1, 0, 2, f64_neg(F64_ONE), 42);
    var ir_neg = generate_ir(src, lis, room, neg);
    assert_eq(vec_len(multiband_ir_band(ir_neg, 0)), 0,
      "generate_ir negative max_time -> 0 samples");

    # NaN max_time: Rust's `NaN as usize` is 0.
    var nan_cfg = ir_config_new(48000, 1, 0, 2, _h_nan(), 42);
    var ir_nan = generate_ir(src, lis, room, nan_cfg);
    assert_eq(vec_len(multiband_ir_band(ir_nan, 0)), 0,
      "generate_ir NaN max_time -> 0 samples");

    # An ordinary duration is unaffected: 0.05 s at 48 kHz = 2400 samples.
    var ok = ir_config_new(48000, 1, 0, 2, f64_div(f64_from(5), f64_from(100)), 42);
    var ir_ok = generate_ir(src, lis, room, ok);
    assert_eq(vec_len(multiband_ir_band(ir_ok, 0)), 2400,
      "generate_ir 0.05s @ 48kHz -> 2400 samples");
    return 0;
}

# ================================================================
# ambisonics / radiosity -- negative caller-supplied indices aborted
# the process inside vec_set / vec_get.
# ================================================================
fn _h_index_guards() {
    test_group("ambisonics/radiosity: negative indices do not abort");

    var bf = new_bformat_ir(64, 48000);
    assert_eq(encode_bformat(F64_ONE, hvec3_unit_x(), 0 - 5, bf), 0,
      "encode_bformat negative delay -> no-op");

    var hoa = new_hoa_ir(1, 64, 48000);
    assert_eq(encode_hoa(F64_ONE, hvec3_unit_x(), 0 - 5, hoa), 0,
      "encode_hoa negative delay -> no-op");

    var mat = acoustic_material_concrete();
    var geom = room_geometry_shoebox(f64_from(10), f64_from(8), f64_from(3), mat);
    var patches = create_patches(RoomGeometry_walls(geom), f64_from(2));
    var energy = alloc(NUM_BANDS * 8);
    var b = 0;
    while (b < NUM_BANDS) {
        store64(energy + b * 8, F64_ONE);
        b = b + 1;
    }
    var res = solve_radiosity(patches, 0 - 1, energy, 10, _h_pct(1));
    assert_eq(RadiosityResult_iterations(res), 0,
      "solve_radiosity negative source_patch -> 0 iterations, no abort");
    return 0;
}

# ================================================================
# f64_to saturation (2.0.6) -- cyrius 6.6.8 made f64_to saturate. Three sites
# floored with `if (n < 1) { n = 1; }` and relied on +Inf arriving as INT64_MIN
# to land on that floor. It now arrives as INT64_MAX, so each ran a vec_push loop
# until the process was out of memory, with every other test still green.
# ADR-0003. These two groups fail on 2.0.5's source built by 6.6.20.
# ================================================================
fn _h_f64_to_saturation() {
    test_group("f64_to: the semantics ADR-0003 rests on");
    # A tripwire, not a parity test: if a toolchain moves these again, audit
    # every f64_to site rather than trust the suite.
    assert_eq(f64_to(_h_nan()), 0, "f64_to(NaN) == 0");
    assert_eq(f64_to(_h_inf()), 0x7FFFFFFFFFFFFFFF, "f64_to(+Inf) == INT64_MAX");
    assert_eq(f64_to(f64_neg(_h_inf())), 0x8000000000000000, "f64_to(-Inf) == INT64_MIN");
    assert_eq(f64_to(f64_neg(f64_from(3))), 0 - 3, "f64_to keeps a negative's sign");

    test_group("gaussian pulses: an unbounded span stops at the solver's step cap");
    var fp = fdtd_source_gaussian_pulse(1, 1, 4, _h_inf(), F64_ONE);
    assert_eq(vec_len(FdtdSource_signal(fp)), MAX_TIME_STEPS, "fdtd +Inf sigma -> step cap");
    var fn2 = fdtd_source_gaussian_pulse(1, 1, 4, _h_nan(), F64_ONE);
    assert_eq(vec_len(FdtdSource_signal(fn2)), 1, "fdtd NaN sigma -> 1, Rust's .max(1)");
    var dp = dwm_source_gaussian_pulse(1, 1, 1, 4, _h_inf(), F64_ONE);
    assert_eq(vec_len(DwmSource_signal(dp)), DWM_MAX_TIME_STEPS, "dwm +Inf sigma -> step cap");
    var dn = dwm_source_gaussian_pulse(1, 1, 1, 4, _h_nan(), F64_ONE);
    assert_eq(vec_len(DwmSource_signal(dn)), 1, "dwm NaN sigma -> 1, Rust's .max(1)");

    test_group("fdn: a non-finite room is a capped line, not an unbounded one");
    var four = f64_from(4);
    var three = f64_from(3);
    var ci = fdn_config_for_room(_h_inf(), four, three, F64_ONE, 48000);
    # Config only: fdn_new at the cap takes 8 s and about 9.3 GiB, too much for a
    # suite that runs on every change. An uncapped length fails this line anyway.
    assert_eq(vec_get(FdnConfig_delay_lengths(ci), 0), FDN_MAX_DELAY_SAMPLES, "+Inf length -> cap");
    var cn = fdn_config_for_room(_h_nan(), four, three, F64_ONE, 48000);
    assert_eq(vec_get(FdnConfig_delay_lengths(cn), 0), 1, "NaN length -> 1, Rust's .max(1)");
    return 0;
}

# ================================================================
# room bounds (2.0.6) -- Rust takes bounds with glam's Vec3::min / max, which ignore
# NaN. hisab's hvec3_min / hvec3_max propagate it, so moving to hisab 3.3.7 made one
# NaN vertex poison the bounds: volume NaN and every image source lost.
# ================================================================
fn _h_nan_vertex() {
    test_group("room bounds: a NaN vertex is ignored, as glam's Vec3::min does");
    var a = hvec3_new(_h_nan(), F64_ONE, f64_from(2));
    var b = hvec3_new(F64_ONE, _h_nan(), f64_from(3));
    assert_eq(HVec3_x(room_vec_min(a, b)), F64_ONE, "min: NaN in first operand ignored");
    assert_eq(HVec3_y(room_vec_min(a, b)), F64_ONE, "min: NaN in second operand ignored");
    assert_eq(HVec3_z(room_vec_min(a, b)), f64_from(2), "min: finite operands still compare");
    assert_eq(HVec3_x(room_vec_max(a, b)), F64_ONE, "max: NaN in first operand ignored");
    assert_eq(HVec3_y(room_vec_max(a, b)), F64_ONE, "max: NaN in second operand ignored");
    assert_eq(HVec3_z(room_vec_max(a, b)), f64_from(3), "max: finite operands still compare");

    # Every slot of the first and last wall, so neither the order nor an
    # asymmetric comparison can hide the NaN.
    var src = hvec3_new(f64_from(2), f64_from(2), F64_ONE);
    var lis = hvec3_new(f64_from(6), f64_from(5), F64_ONE);
    var clean = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    var want = vec_len(compute_early_reflections(src, lis, clean, 2, f64_from(343)));
    var nw = vec_len(RoomGeometry_walls(AcousticRoom_geometry(clean)));
    var bad = 0;
    var w = 0;
    while (w < nw) {
        var slot = 0;
        while (slot < 4) {
            var r = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
            var geom = AcousticRoom_geometry(r);
            var verts = Wall_vertices(vec_get(RoomGeometry_walls(geom), w));
            vec_set(verts, slot, hvec3_new(_h_nan(), F64_ONE, F64_ONE));
            if (f64_eq(room_geometry_volume_shoebox(geom), f64_from(240)) == 0) { bad = bad + 1; }
            if (vec_len(compute_early_reflections(src, lis, r, 2, f64_from(343))) != want) { bad = bad + 1; }
            slot = slot + 1;
        }
        w = w + nw - 1;
    }
    assert(want > 1, "the clean room really has image sources to lose");
    assert_eq(bad, 0, "NaN vertex in any slot of first/last wall: volume and reflections unchanged");
    return 0;
}

alloc_init();
_h_fdtd();
_h_dwm();
_h_material();
_h_metamaterial();
_h_analysis();
_h_propagation();
_h_ir_sample_count();
_h_index_guards();
_h_f64_to_saturation();
_h_nan_vertex();

var rc = assert_summary();
syscall(60, rc);
