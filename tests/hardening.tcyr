# hardening.tcyr -- regression suite for the 2.0.2 P-1 hardening pass.
#
# Every case here is a defect that was REPRODUCED against 2.0.1 (most as a
# SIGSEGV or a hard process abort) and is now expected to return a degenerate
# result instead. They share one root cause: the Rust oracle typed its indices
# and extents `usize`/`u32`, so non-negativity and saturating float->int casts
# came free from the type system. The Cyrius port carries all of them as signed
# i64, and `f64_to` did not saturate until cyrius 6.6.8, so every guard that Rust
# wrote as a single upper-bound test lost its lower half.
#
# Run: cyrius test tests/hardening.tcyr
#
# Tests the SHIPPED bundle (same posture as bundle.tcyr), so it also proves the
# repairs reached dist/goonj.cyr.
include "lib/hisab.cyr"
include "lib/sakshi.cyr"
include "dist/goonj.cyr"

fn _h_pct(n) { return f64_div(f64_from(n), f64_from(100)); }
fn _h_nan() { return f64_div(f64_from(0), f64_from(0)); }
fn _h_inf() { return f64_div(f64_from(1), f64_from(0)); }

fn _h_sig1() {
    var v = vec_new();
    vec_push(v, F64_ONE);
    return v;
}

# ================================================================
# fdtd -- negative source/receiver indices, and the cell-cap overflow.
# 2.0.1: each of these exited 139 (SIGSEGV).
# ================================================================
fn _h_fdtd() {
    test_group("fdtd: negative indices and cap overflow are rejected");

    var cfg = fdtd_config_new(22050, _h_pct(5), f64_from(343), 40, 40, _h_pct(1));

    # Negative source index: passed `>= nx` and stored before the grid buffer.
    var r1 = solve_fdtd_2d(cfg, fdtd_source_new(0 - 100000000, 0, _h_sig1()), vec_new());
    assert_eq(FdtdResult_time_steps(r1), 0, "fdtd negative source ix -> empty result");

    var r2 = solve_fdtd_2d(cfg, fdtd_source_new(0, 0 - 7, _h_sig1()), vec_new());
    assert_eq(FdtdResult_time_steps(r2), 0, "fdtd negative source iy -> empty result");

    # Negative receiver index: passed `< nx` and read outside the field.
    var recv = vec_new();
    vec_push(recv, fdtd_receiver_new(0 - 100000000, 0));
    var r3 = solve_fdtd_2d(cfg, fdtd_source_new(1, 1, _h_sig1()), recv);
    var tr = vec_get(FdtdResult_receiver_signals(r3), 0);
    assert_eq(vec_len(tr), 0, "fdtd negative receiver -> silent (empty) trace");

    # nx * ny wrapped past MAX_GRID_CELLS: 4 * (2^62+1) == 4 (mod 2^64).
    var big = fdtd_config_new(22050, _h_pct(5), f64_from(343), 4, 4611686018427387905, _h_pct(1));
    var r4 = solve_fdtd_2d(big, fdtd_source_new(1, 1, _h_sig1()), vec_new());
    assert_eq(FdtdResult_time_steps(r4), 0, "fdtd nx*ny overflow -> empty result");

    # A valid solve still works (the guards must not over-reject).
    var ok = solve_fdtd_2d(cfg, fdtd_source_new(20, 20, _h_sig1()), vec_new());
    assert_gt(FdtdResult_time_steps(ok), 0, "fdtd valid config still solves");
    return 0;
}

# ================================================================
# dwm -- negative receiver indices and the 3-way cap overflow.
# ================================================================
fn _h_dwm() {
    test_group("dwm: negative indices and cap overflow are rejected");

    var dx = f64_mul(f64_div(f64_from(343), f64_from(22050)), DWM_SQRT_3);
    var cfg = dwm_config_new(22050, dx, f64_from(343), 6, 6, 6, _h_pct(1), wall_materials_rigid());
    var src = dwm_source_gaussian_pulse(1, 1, 1, 4, f64_from(2), F64_ONE);

    var recv = vec_new();
    vec_push(recv, dwm_receiver_new(0 - 100000000, 1, 1));
    var r1 = solve_dwm_3d(cfg, src, recv);
    var tr = vec_get(DwmResult_receiver_signals(r1), 0);
    assert_eq(vec_len(tr), 0, "dwm negative receiver -> silent (empty) trace");

    # Negative source index.
    var r2 = solve_dwm_3d(cfg, dwm_source_gaussian_pulse(0 - 5, 1, 1, 4, f64_from(2), F64_ONE), vec_new());
    assert_eq(DwmResult_time_steps(r2), 0, "dwm negative source -> empty result");

    # nx*ny*nz wrapped: 4 * 4 * (2^60+1) == 16 (mod 2^64).
    var big = dwm_config_new(22050, dx, f64_from(343), 4, 4, 1152921504606846977,
      _h_pct(1), wall_materials_rigid());
    var r3 = solve_dwm_3d(big, dwm_source_gaussian_pulse(1, 1, 1, 4, f64_from(2), F64_ONE), vec_new());
    assert_eq(DwmResult_time_steps(r3), 0, "dwm nx*ny*nz overflow -> empty result");
    return 0;
}

# ================================================================
# material -- Rust rejects NaN via !(0.0..=1.0).contains(); the port's
# two one-sided rejections accepted it.
# ================================================================
fn _h_material() {
    test_group("material: NaN coefficients are rejected");

    var bands = alloc(NUM_BANDS * 8);
    var i = 0;
    while (i < NUM_BANDS) {
        store64(bands + i * 8, _h_pct(10));
        i = i + 1;
    }
    var good = acoustic_material_new("ok", bands, F64_HALF);
    assert_neq(good, 0, "valid material still accepted");

    store64(bands + 3 * 8, _h_nan());
    assert_eq(acoustic_material_new("nanabs", bands, F64_HALF), 0,
      "NaN absorption band rejected");

    store64(bands + 3 * 8, _h_pct(10));
    assert_eq(acoustic_material_new("nanscat", bands, _h_nan()), 0,
      "NaN scattering rejected");

    # The existing range rejections must still hold.
    assert_eq(acoustic_material_new("hiscat", bands, f64_from(2)), 0,
      "scattering > 1 still rejected");
    return 0;
}

# ================================================================
# metamaterial -- an odd-length flattened (freq, abs) vec read index 1
# out of bounds and aborted the process.
# ================================================================
fn _h_metamaterial() {
    test_group("metamaterial: odd-length lookup rows do not abort");

    var rows = mm_rows_new();
    vec_push(rows, f64_from(500));
    var m = metamaterial_lookup_table(rows);
    assert_eq(metamaterial_absorption_at(m, f64_from(500)), 0,
      "odd-length lookup rows -> 0, no abort");

    var ok = mm_rows_new();
    mm_rows_push(ok, f64_from(500), F64_HALF);
    var m2 = metamaterial_lookup_table(ok);
    assert_eq(metamaterial_absorption_at(m2, f64_from(500)), F64_HALF,
      "well-formed single row still looks up");
    return 0;
}

# ================================================================
# analysis -- a negative sample_rate produced a negative vec index and
# killed the host process inside vec_get.
# ================================================================
fn _h_analysis() {
    test_group("analysis: negative sample_rate does not abort");

    var samples = vec_new();
    var i = 0;
    while (i < 1000) {
        vec_push(samples, F64_ONE);
        i = i + 1;
    }
    var ir = impulse_response_new(samples, 0 - 48000, F64_ONE);
    assert_eq(clarity_c50(ir), 0, "clarity_c50 with negative rate -> 0");
    assert_eq(clarity_c80(ir), 0, "clarity_c80 with negative rate -> 0");
    return 0;
}

# ================================================================
# propagation -- f64_to did not saturate before cyrius 6.6.8, so an
# infinite/huge max_distance made max_iter INT64_MIN and returned a 1-point path.
# ================================================================
fn _h_propagation() {
    test_group("propagation: non-finite max_distance saturates like Rust");

    # wind/temp are profile handles, not raw values.
    var wcalm = wind_profile_new(hvec3_unit_x(), 0, 0);
    var tflat = temperature_profile_new(f64_from(20), 0);
    var src = hvec3_new(0, f64_from(10), 0);

    # Rust: `(max_distance / step.max(0.001)) as u32` saturates to u32::MAX, then
    # .min(1_000_000). 2.0.1 returned a 1-point path instead (INT64_MIN max_iter).
    var p1 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, _h_inf(), F64_ONE);
    assert_eq(vec_len(p1), 1000001, "+inf max_distance -> 1000001 points, not 1");

    # 1e19 (> i64::MAX: past f64_to's range, whichever way it fails).
    var huge = f64_mul(f64_from(1000000000), f64_from(10000000000));
    var p2 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, huge, F64_ONE);
    assert_eq(vec_len(p2), 1000001, "1e19 max_distance -> 1000001 points, not 1");

    # NaN must match Rust's `NaN as u32 == 0`: no steps.
    var p3 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, _h_nan(), F64_ONE);
    assert_eq(vec_len(p3), 1, "NaN max_distance -> source-only path (Rust parity)");

    # A normal trace is unaffected.
    var p4 = trace_ray_atmospheric(src, hvec3_unit_x(), wcalm, tflat, f64_from(100), F64_ONE);
    assert_gt(vec_len(p4), 1, "ordinary trace still works");
    return 0;
}

# ================================================================
# impulse / binaural -- Rust's `as usize` cast SATURATES (NaN and
# negatives to 0, overflow to usize::MAX). Cyrius f64_to keeps the sign,
# so the sample-count clamp has to happen in f64. Mapping the INT64_MIN
# sentinel to max_samples instead (as 2.0.2 first did) turns Rust's
# no-op into an 8 x 115.2M x 8 B ~= 7.4 GB allocation.
# ================================================================
fn _h_ir_sample_count() {
    test_group("impulse/binaural: non-finite max_time yields an empty IR, not 7.4 GB");

    var mat = acoustic_material_concrete();
    var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), mat);
    var src = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
    var lis = hvec3_new(f64_from(5), F64_ONE, f64_from(2));

    # Negative max_time: Rust saturates to 0 samples.
    var neg = ir_config_new(48000, 1, 0, 2, f64_neg(F64_ONE), 42);
    var ir_neg = generate_ir(src, lis, room, neg);
    assert_eq(vec_len(multiband_ir_band(ir_neg, 0)), 0,
      "generate_ir negative max_time -> 0 samples");

    # NaN max_time: Rust's `NaN as usize` is 0.
    var nan_cfg = ir_config_new(48000, 1, 0, 2, _h_nan(), 42);
    var ir_nan = generate_ir(src, lis, room, nan_cfg);
    assert_eq(vec_len(multiband_ir_band(ir_nan, 0)), 0,
      "generate_ir NaN max_time -> 0 samples");

    # An ordinary duration is unaffected: 0.05 s at 48 kHz = 2400 samples.
    var ok = ir_config_new(48000, 1, 0, 2, f64_div(f64_from(5), f64_from(100)), 42);
    var ir_ok = generate_ir(src, lis, room, ok);
    assert_eq(vec_len(multiband_ir_band(ir_ok, 0)), 2400,
      "generate_ir 0.05s @ 48kHz -> 2400 samples");
    return 0;
}

# ================================================================
# ambisonics / radiosity -- negative caller-supplied indices aborted
# the process inside vec_set / vec_get.
# ================================================================
fn _h_index_guards() {
    test_group("ambisonics/radiosity: negative indices do not abort");

    var bf = new_bformat_ir(64, 48000);
    assert_eq(encode_bformat(F64_ONE, hvec3_unit_x(), 0 - 5, bf), 0,
      "encode_bformat negative delay -> no-op");

    var hoa = new_hoa_ir(1, 64, 48000);
    assert_eq(encode_hoa(F64_ONE, hvec3_unit_x(), 0 - 5, hoa), 0,
      "encode_hoa negative delay -> no-op");

    var mat = acoustic_material_concrete();
    var geom = room_geometry_shoebox(f64_from(10), f64_from(8), f64_from(3), mat);
    var patches = create_patches(RoomGeometry_walls(geom), f64_from(2));
    var energy = alloc(NUM_BANDS * 8);
    var b = 0;
    while (b < NUM_BANDS) {
        store64(energy + b * 8, F64_ONE);
        b = b + 1;
    }
    var res = solve_radiosity(patches, 0 - 1, energy, 10, _h_pct(1));
    assert_eq(RadiosityResult_iterations(res), 0,
      "solve_radiosity negative source_patch -> 0 iterations, no abort");
    return 0;
}

# ================================================================
# f64_to saturation (2.0.6) -- cyrius 6.6.8 made f64_to saturate. Three sites
# floored with `if (n < 1) { n = 1; }` and relied on +Inf arriving as INT64_MIN
# to land on that floor. It now arrives as INT64_MAX, so each ran a vec_push loop
# until the process was out of memory, with every other test still green.
# ADR-0003. These two groups fail on 2.0.5's source built by 6.6.20.
# ================================================================
fn _h_f64_to_saturation() {
    test_group("f64_to: the semantics ADR-0003 rests on");
    # A tripwire, not a parity test: if a toolchain moves these again, audit
    # every f64_to site rather than trust the suite.
    assert_eq(f64_to(_h_nan()), 0, "f64_to(NaN) == 0");
    assert_eq(f64_to(_h_inf()), 0x7FFFFFFFFFFFFFFF, "f64_to(+Inf) == INT64_MAX");
    assert_eq(f64_to(f64_neg(_h_inf())), 0x8000000000000000, "f64_to(-Inf) == INT64_MIN");
    assert_eq(f64_to(f64_neg(f64_from(3))), 0 - 3, "f64_to keeps a negative's sign");

    test_group("gaussian pulses: an unbounded span stops at the solver's step cap");
    var fp = fdtd_source_gaussian_pulse(1, 1, 4, _h_inf(), F64_ONE);
    assert_eq(vec_len(FdtdSource_signal(fp)), MAX_TIME_STEPS, "fdtd +Inf sigma -> step cap");
    var fn2 = fdtd_source_gaussian_pulse(1, 1, 4, _h_nan(), F64_ONE);
    assert_eq(vec_len(FdtdSource_signal(fn2)), 1, "fdtd NaN sigma -> 1, Rust's .max(1)");
    var dp = dwm_source_gaussian_pulse(1, 1, 1, 4, _h_inf(), F64_ONE);
    assert_eq(vec_len(DwmSource_signal(dp)), DWM_MAX_TIME_STEPS, "dwm +Inf sigma -> step cap");
    var dn = dwm_source_gaussian_pulse(1, 1, 1, 4, _h_nan(), F64_ONE);
    assert_eq(vec_len(DwmSource_signal(dn)), 1, "dwm NaN sigma -> 1, Rust's .max(1)");

    test_group("fdn: a non-finite room is a capped line, not an unbounded one");
    var four = f64_from(4);
    var three = f64_from(3);
    var ci = fdn_config_for_room(_h_inf(), four, three, F64_ONE, 48000);
    # Config only: fdn_new at the cap takes 8 s and about 9.3 GiB, too much for a
    # suite that runs on every change. An uncapped length fails this line anyway.
    assert_eq(vec_get(FdnConfig_delay_lengths(ci), 0), FDN_MAX_DELAY_SAMPLES, "+Inf length -> cap");
    var cn = fdn_config_for_room(_h_nan(), four, three, F64_ONE, 48000);
    assert_eq(vec_get(FdnConfig_delay_lengths(cn), 0), 1, "NaN length -> 1, Rust's .max(1)");
    return 0;
}

# ================================================================
# room bounds (2.0.6) -- Rust takes bounds with glam's Vec3::min / max, which ignore
# NaN. hisab's hvec3_min / hvec3_max propagate it, so moving to hisab 3.3.7 made one
# NaN vertex poison the bounds: volume NaN and every image source lost.
# ================================================================
fn _h_nan_vertex() {
    test_group("room bounds: a NaN vertex is ignored, as glam's Vec3::min does");
    var a = hvec3_new(_h_nan(), F64_ONE, f64_from(2));
    var b = hvec3_new(F64_ONE, _h_nan(), f64_from(3));
    assert_eq(HVec3_x(room_vec_min(a, b)), F64_ONE, "min: NaN in first operand ignored");
    assert_eq(HVec3_y(room_vec_min(a, b)), F64_ONE, "min: NaN in second operand ignored");
    assert_eq(HVec3_z(room_vec_min(a, b)), f64_from(2), "min: finite operands still compare");
    assert_eq(HVec3_x(room_vec_max(a, b)), F64_ONE, "max: NaN in first operand ignored");
    assert_eq(HVec3_y(room_vec_max(a, b)), F64_ONE, "max: NaN in second operand ignored");
    assert_eq(HVec3_z(room_vec_max(a, b)), f64_from(3), "max: finite operands still compare");

    # Every slot of the first and last wall, so neither the order nor an
    # asymmetric comparison can hide the NaN.
    var src = hvec3_new(f64_from(2), f64_from(2), F64_ONE);
    var lis = hvec3_new(f64_from(6), f64_from(5), F64_ONE);
    var clean = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    var want = vec_len(compute_early_reflections(src, lis, clean, 2, f64_from(343)));
    var nw = vec_len(RoomGeometry_walls(AcousticRoom_geometry(clean)));
    var bad = 0;
    var w = 0;
    while (w < nw) {
        var slot = 0;
        while (slot < 4) {
            var r = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
            var geom = AcousticRoom_geometry(r);
            var verts = Wall_vertices(vec_get(RoomGeometry_walls(geom), w));
            vec_set(verts, slot, hvec3_new(_h_nan(), F64_ONE, F64_ONE));
            if (f64_eq(room_geometry_volume_shoebox(geom), f64_from(240)) == 0) { bad = bad + 1; }
            if (vec_len(compute_early_reflections(src, lis, r, 2, f64_from(343))) != want) { bad = bad + 1; }
            slot = slot + 1;
        }
        w = w + nw - 1;
    }
    assert(want > 1, "the clean room really has image sources to lose");
    assert_eq(bad, 0, "NaN vertex in any slot of first/last wall: volume and reflections unchanged");
    return 0;
}

# ================================================================
# 2.1.3 -- public index accessors. Rust's `[f32; NUM_BANDS]` fields panic out of
# range. These were raw load64/store64: band -1 read the field before, a far
# index faulted, and mbr_set_energy_band was a wild write through the public API.
# ================================================================
fn _h_band_accessors() {
    test_group("2.1.3: out-of-range band indices read 0 and write nothing");
    var src = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
    var ray = multiband_ray_new(src, hvec3_unit_x());
    assert_eq(mbr_energy_band(ray, 0 - 1), 0, "mbr_energy_band(-1) -> 0");
    assert_eq(mbr_energy_band(ray, NUM_BANDS), 0, "mbr_energy_band(NUM_BANDS) -> 0");
    assert_eq(mbr_energy_band(ray, 1 << 40), 0, "mbr_energy_band(huge) -> 0");
    mbr_set_energy_band(ray, 0 - 1, _h_inf());
    mbr_set_energy_band(ray, NUM_BANDS, _h_inf());
    mbr_set_energy_band(ray, 1 << 40, _h_inf());
    assert_eq(mbr_origin(ray), src, "mbr_set_energy_band(-1..) leaves the fields alone");
    assert_eq(mbr_distance(ray), 0, "mbr_set_energy_band(NUM_BANDS) leaves the distance alone");
    assert_eq(mbr_energy_band(ray, 7), F64_ONE, "a valid band still reads back");

    var mat = acoustic_material_concrete();
    assert_eq(am_absorption_band(mat, 0 - 1), 0, "am_absorption_band(-1) -> 0");
    assert_eq(am_absorption_band(mat, NUM_BANDS), 0, "am_absorption_band(NUM_BANDS) -> 0");
    assert(f64_gt(am_absorption_band(mat, NUM_BANDS - 1), 0) == 1, "a valid band still reads");

    var map = soorat_pressure_map_new(vec_new(), 2, 3, 4, src, F64_ONE, F64_ONE);
    assert_eq(soorat_pressure_map_dimension(map, 2), 4, "pressure map z dimension");
    assert_eq(soorat_pressure_map_dimension(map, 0 - 1), 0, "pressure map dimension(-1) -> 0");
    assert_eq(soorat_pressure_map_dimension(map, 3), 0, "pressure map dimension(3) -> 0");
    return 0;
}

# ================================================================
# 2.1.3 -- NaN parity. f64_min and f64_max keep a NaN in the second position, which
# Rust's min and max ignore, and a guard written as the negation of Rust's test
# sends NaN the other way. Each of these matched neither Rust nor a green suite.
# ================================================================
fn _h_nan_parity() {
    test_group("2.1.3: NaN takes the branch Rust's test sends it down");
    var src = hvec3_new(f64_from(2), f64_from(2), F64_ONE);
    var lis = hvec3_new(f64_from(6), f64_from(5), F64_ONE);
    var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    var walls = RoomGeometry_walls(AcousticRoom_geometry(room));

    # A fold over [.., NaN] kept the NaN, and a fold over [.., NaN, x] lost the peak.
    var ray = multiband_ray_new(src, hvec3_unit_x());
    mbr_set_energy_band(ray, 7, _h_nan());
    assert_eq(multiband_ray_max_energy(ray), F64_ONE, "max_energy ignores a NaN last band");
    var m = multiband_ir_new(1000, F64_ONE);
    var b0 = multiband_ir_band(m, 0);
    vec_push(b0, f64_from(5));
    vec_push(b0, _h_nan());
    vec_push(b0, F64_ONE);
    var bb = ImpulseResponse_samples(multiband_ir_to_broadband(m));
    assert_eq(vec_get(bb, 0), F64_ONE, "normalization finds the peak across a NaN sample");

    # Rust: length.max(width).max(height). width NaN leaves max(10, 3).
    var cfg = fdn_config_for_room(f64_from(10), _h_nan(), f64_from(3), F64_ONE, 48000);
    var dl = FdnConfig_delay_lengths(cfg);
    assert_eq(vec_get(dl, 7), vec_get(dl, 0), "fdn longest-dimension delay ignores a NaN width");

    var q = vec_new();
    vec_push(q, compute_diffraction_filter(_h_nan(), F64_ONE, f64_from(20)));
    vec_push(q, compute_diffraction_filter(F64_ONE, F64_ONE, f64_from(20)));
    assert_eq(df_quality(chain_diffraction_filters(q)), df_quality(vec_get(q, 1)),
      "chained quality ignores a NaN filter");

    # Rust's Some(NaN) is a hit that nothing can then beat. The port called it a miss.
    var nan_src = hvec3_new(_h_nan(), f64_from(2), F64_ONE);
    var nan_path = trace_ray(multiband_ray_new(nan_src, hvec3_unit_x()), walls, 10);
    assert_eq(vec_len(ray_path_bounces(nan_path)), 10, "a NaN origin still bounces, as in Rust");

    # Rust drops on `distance < EPSILON`, so NaN stays in the list.
    var nan_lis = hvec3_new(_h_nan(), F64_ONE, F64_ONE);
    assert_eq(vec_len(compute_early_reflections(src, nan_lis, room, 1, f64_from(343))), 7,
      "a NaN listener keeps its seven reflections, as in Rust");

    # The one recorded gap (ADR-0005): hisab's BVH reports no leaf on a NaN slab.
    var nan_bvh = trace_ray_bvh(multiband_ray_new(nan_src, hvec3_unit_x()), accelerated_room_new(room), 10);
    assert_eq(vec_len(ray_path_bounces(nan_bvh)), 0, "a NaN origin through the BVH hits nothing");

    # Rust panics on wall.vertices[0], and this aborted in vec_get.
    var bare = vec_new();
    vec_push(bare, wall_new(vec_new(), acoustic_material_concrete(), hvec3_unit_y()));
    assert_eq(vec_len(compute_image_sources_general(src, bare, 2)), 1, "a wall with no vertices is skipped");

    # Rust keeps the direction on `len > EPSILON`, so NaN returns the source.
    var wind = wind_profile_new(hvec3_unit_x(), 0, 0);
    var temp = temperature_profile_new(f64_from(20), 0);
    var nan_dir = hvec3_new(_h_nan(), 0, 0);
    assert_eq(vec_len(trace_ray_atmospheric(src, nan_dir, wind, temp, f64_from(100), F64_ONE)), 1,
      "a NaN direction returns just the source");

    # Rust keeps the surface value on `depth <= mixed_layer`, so NaN goes below it.
    var surface = ocean_profile_new(f64_from(15), f64_from(35), 0);
    var at_depth = ocean_speed_at_depth(surface, F64_ONE, _h_nan(), f64_from(100));
    assert(f64_eq(at_depth, at_depth) == 1, "ocean speed with a NaN mixed layer stays finite");
    assert_eq(at_depth, ocean_sound_speed(ocean_profile_new(f64_neg(F64_TWO), f64_from(35), f64_from(100))),
      "a NaN mixed layer takes Rust's thermocline branch, floored at -2 C");

    # Rust takes +1 on `y >= 0`, so a NaN y gets -1.
    var step = refract_ray_step(src, hvec3_new(F64_HALF, _h_nan(), 0), &_h_speed_fn, 0, F64_ONE);
    assert(f64_lt(HVec3_y(RayStep_direction(step)), 0) == 1, "a NaN vertical component bends down");

    # Rust's Ray::new rejects len_sq < 1e-7 (hisab geo/primitives.rs:30).
    var accel = accelerated_room_new(room);
    var bvh = AcceleratedRoom_bvh(accel);
    var tiny = hvec3_new(f64_div(F64_ONE, f64_from(100000)), 0, 0);
    assert_eq(find_nearest_wall_bvh(src, tiny, walls, bvh, 0 - 1), 0, "a tiny direction is None");
    assert(find_nearest_wall_bvh(src, hvec3_unit_x(), walls, bvh, 0 - 1) != 0, "a unit direction hits");
    return 0;
}

fn _h_speed_fn(ctx, h) { return f64_from(343); }

# ================================================================
# 2.1.3 -- Rust's usize and u32 floor at 0. These each echoed a negative or behaved
# as if the sign were not there.
# ================================================================
fn _h_negative_counts() {
    test_group("2.1.3: negative rates and counts act as their u32 floor");
    var sig = vec_new();
    vec_push(sig, F64_ONE);
    vec_push(sig, F64_HALF);
    var zero = 1;
    var band = band_energies(sig, 0 - 48000);
    var i = 0;
    while (i < NUM_BANDS) {
        if (load64(band + i * 8) != 0) { zero = 0; }
        i = i + 1;
    }
    assert_eq(zero, 1, "band_energies at a negative rate -> zeros");
    assert_eq(required_dx(0 - 1, f64_from(343)), 0, "required_dx at a negative rate -> 0");
    var dc = dwm_config_new(0 - 48000, F64_ONE, f64_from(343), 8, 8, 8, F64_ONE, wall_materials_rigid());
    assert_eq(dispersion_factor(dc, f64_from(100)), F64_ONE, "dispersion_factor at a negative rate -> 1");

    var fs = fdtd_source_gaussian_pulse(1, 1, 0 - 10, F64_ONE, F64_ONE);
    var f0 = fdtd_source_gaussian_pulse(1, 1, 0, F64_ONE, F64_ONE);
    assert_eq(vec_len(FdtdSource_signal(fs)), vec_len(FdtdSource_signal(f0)), "fdtd negative peak_step -> 0");
    var ds = dwm_source_gaussian_pulse(1, 1, 1, 0 - 10, F64_ONE, F64_ONE);
    var d0 = dwm_source_gaussian_pulse(1, 1, 1, 0, F64_ONE, F64_ONE);
    assert_eq(vec_get(DwmSource_signal(ds), 0), vec_get(DwmSource_signal(d0), 0), "dwm negative peak_step -> 0");

    assert_eq(vec_len(HoaIr_channels(new_hoa_ir(0 - 5, 4, 48000))), 1, "negative HOA order -> order 0");

    # (2^32 + 48000) used to write a clean-looking 48 kHz header.
    assert(goonj_is_err(write_wav_mono(sig, 0 - 48000)) == 1, "wav mono rejects a negative rate");
    assert(goonj_is_err(write_wav_mono(sig, 0x100000000 + 48000)) == 1, "wav mono rejects rate > u32");
    assert(goonj_is_err(write_wav_stereo(sig, sig, 0 - 48000)) == 1, "wav stereo rejects a negative rate");
    assert(goonj_is_err(write_wav_mono(sig, 48000)) == 0, "wav still writes a valid rate");

    var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    var src = hvec3_new(f64_from(2), f64_from(2), F64_ONE);
    var rain = diffuse_rain_config_new(0 - 5, 4, F64_ONE, F64_ONE, f64_from(343), 1);
    assert_eq(DiffuseRainResult_rays_traced(generate_diffuse_rain(src, src, room, rain)), 0,
      "negative num_rays -> 0 rays traced");
    var patches = create_patches(RoomGeometry_walls(AcousticRoom_geometry(room)), 1);
    var energy = alloc(NUM_BANDS * 8);
    assert_eq(RadiosityResult_iterations(solve_radiosity(patches, 0, energy, 0 - 1, F64_ONE)), 0,
      "negative max_iterations -> 0 iterations");

    # The gain used the raw length, so -48000 gave a gain of 1000 and a blow-up.
    var lens = vec_new();
    vec_push(lens, 0 - 48000);
    var cfg = alloc(sizeof(FdnConfig));
    FdnConfig_set_num_delays(cfg, 1);
    FdnConfig_set_delay_lengths(cfg, lens);
    FdnConfig_set_feedback_gains(cfg, vec_new());
    FdnConfig_set_sample_rate(cfg, 48000);
    FdnConfig_set_target_rt60(cfg, F64_ONE);
    var fdn = fdn_new(cfg);
    var o = F64_ONE;
    i = 0;
    while (i < 200) {
        o = fdn_process_sample(fdn, o);
        i = i + 1;
    }
    assert(f64_eq(o, o) == 1, "a negative hand-built delay length stays stable");
    return 0;
}

# ================================================================
# 2.1.3 -- loops that input could run away. axial_modes aborted at vec's 2^28 cap on
# any non-finite argument, all_axial_modes and diffuse rain sorted in O(n^2), and an
# i64 rate gave iacc 1e12 lags where Rust's u32 stopped near 4e6.
# ================================================================
fn _h_runaway_loops() {
    test_group("2.1.3: runaway loops stop");
    var c = f64_from(343);
    assert_eq(vec_len(axial_modes(_h_nan(), f64_from(100), c)), 0, "NaN dimension -> no modes");
    assert_eq(vec_len(axial_modes(f64_from(5), _h_nan(), c)), 0, "NaN max_frequency -> no modes");
    assert_eq(vec_len(axial_modes(f64_from(5), f64_from(100), _h_nan())), 0, "NaN speed -> no modes");
    assert_eq(vec_len(axial_modes(f64_from(5), _h_inf(), c)), AXIAL_MODES_MAX, "+Inf max stops at the cap");
    assert_eq(vec_len(axial_modes(f64_from(5), f64_from(200), c)), 5, "a real room is untouched");

    # Three interleaved runs over the sort's insertion cutoff, equal keys included.
    var modes = all_axial_modes(f64_from(5), f64_from(4), f64_from(5), f64_from(2000), c);
    var sorted = 1;
    var i = 1;
    while (i < vec_len(modes)) {
        if (f64_gt(vec_get(modes, i - 1), vec_get(modes, i)) == 1) { sorted = 0; }
        i = i + 1;
    }
    assert_gt(vec_len(modes), GOONJ_SORT_INSERTION_MAX, "the merge path ran");
    assert_eq(sorted, 1, "all_axial_modes comes back sorted");

    var left = vec_new();
    var right = vec_new();
    vec_push(left, F64_ONE);
    vec_push(left, F64_HALF);
    vec_push(right, F64_ONE);
    vec_push(right, F64_HALF);
    assert_eq(iacc(left, right, 1000000000000000), F64_ONE, "iacc at a 1e15 rate returns");
    return 0;
}

# goonj_sort_by_key must be stable: Rust's sort_by is, and ties decide output order.
fn _h_sort_item_key(p) { return load64(p); }

fn _h_stable_sort() {
    test_group("2.1.3: goonj_sort_by_key is stable");
    var sizes = vec_new();
    vec_push(sizes, 2);
    vec_push(sizes, GOONJ_SORT_INSERTION_MAX);
    vec_push(sizes, GOONJ_SORT_INSERTION_MAX + 1);
    vec_push(sizes, 1000);
    var s = 0;
    while (s < vec_len(sizes)) {
        var n = vec_get(sizes, s);
        var v = vec_new();
        var i = 0;
        while (i < n) {
            var item = alloc(16);
            store64(item, f64_from((i * 7919) % 17));
            store64(item + 8, i);
            vec_push(v, item);
            i = i + 1;
        }
        goonj_sort_by_key(v, &_h_sort_item_key);
        var ok = 1;
        i = 1;
        while (i < n) {
            var a = vec_get(v, i - 1);
            var b = vec_get(v, i);
            if (f64_gt(load64(a), load64(b)) == 1) { ok = 0; }
            if (f64_eq(load64(a), load64(b)) == 1) {
                if (load64(a + 8) > load64(b + 8)) { ok = 0; }
            }
            i = i + 1;
        }
        assert_eq(ok, 1, "sorted, ties in input order");
        s = s + 1;
    }
    return 0;
}

# ================================================================
# 2.1.3 -- the FDN known limit. fdn_new took 8 s and 9.3 GiB here, because a vec_push
# fill touched every page. The lines now cost address space until used.
# ================================================================
fn _h_fdn_lines_are_vecs() {
    test_group("2.3.1: Fdn_delay_lines is a vec of vecs");
    # 2.1.3 made each line a bare buffer behind the same accessor. vec_len then read the
    # second sample as a length, and vec_get the first as a pointer. naad's suite reads
    # these lines, and its check that a reset clears them passed on length 0.
    var cfg = fdn_config_for_room(F64_ONE, F64_ONE, F64_ONE, F64_ONE, 8000);
    var fdn = fdn_new(cfg);
    var lines = Fdn_delay_lines(fdn);
    var lens = FdnConfig_delay_lengths(cfg);
    var n = vec_len(lines);
    assert_eq(n, vec_len(lens), "one line per delay");
    var unused = fdn_process_sample(fdn, F64_ONE);
    unused = fdn_process_sample(fdn, F64_ONE);
    var share = f64_div(F64_ONE, f64_from(n));
    var i = 0;
    var sized = 1;
    var written = 1;
    while (i < n) {
        var line = vec_get(lines, i);
        if (vec_len(line) != vec_get(lens, i)) { sized = 0; }
        if (vec_get(line, 0) != share) { written = 0; }
        if (vec_get(line, 1) != share) { written = 0; }
        if (vec_get(line, 2) != 0) { written = 0; }
        i = i + 1;
    }
    assert_eq(sized, 1, "each line's length is its delay");
    assert_eq(written, 1, "each line reads back what the FDN wrote");
    fdn_reset(fdn);
    i = 0;
    var cleared = 1;
    while (i < n) {
        var reset_line = vec_get(lines, i);
        var j = 0;
        while (j < vec_len(reset_line)) {
            if (vec_get(reset_line, j) != 0) { cleared = 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert_eq(cleared, 1, "a reset clears what vec_get reads");
    return 0;
}

fn _h_fdn_lazy() {
    test_group("2.1.3: a capped FDN line touches nothing until used");
    var before = alloc_used();
    var fdn = fdn_new(fdn_config_for_room(_h_inf(), F64_ONE, F64_ONE, F64_ONE, 48000));
    assert(alloc_used() > before, "the lines are allocated");
    # Five of the eight lines cap. 2.1.2 grew each by doubling, which was twice this.
    assert(alloc_used() - before < 5 * FDN_MAX_DELAY_SAMPLES * 8 + 1048576, "no doubling garbage");
    var o = fdn_process_sample(fdn, F64_ONE);
    assert_eq(o, 0, "the first output is the empty line");
    o = fdn_process_sample(fdn, F64_ONE);
    assert(f64_eq(o, o) == 1, "an +Inf room still runs");
    assert_eq(vec_len(vec_get(Fdn_delay_lines(fdn), 0)), FDN_MAX_DELAY_SAMPLES, "a capped line is still a vec");

    # fdn_reset wrote zeros through every line, 4.6 GiB resident on a capped FDN. That
    # took down a CI runner when the fuzz harness did it in a loop.
    assert_lt(_h_capped_reset_peak_kib(), 1048576, "fdn_reset leaves a capped line's pages untouched");

    # A line short enough to wrap has every slot written, so all of it must clear.
    var short = fdn_new(fdn_config_for_room(f64_div(F64_ONE, f64_from(100)), F64_ONE, F64_ONE, F64_ONE, 8000));
    var i = 0;
    while (i < 2000) {
        o = fdn_process_sample(short, F64_ONE);
        i = i + 1;
    }
    fdn_reset(short);
    assert_eq(fdn_process_sample(short, 0), 0, "a wrapped line clears completely");
    i = 0;
    var silent = 1;
    while (i < 2000) {
        if (fdn_process_sample(short, 0) != 0) { silent = 0; }
        i = i + 1;
    }
    assert_eq(silent, 1, "nothing survives a reset");
    return 0;
}

# Peak resident KiB of a child that resets a capped FDN: ru_maxrss, the fifth word of
# the struct rusage wait4 fills in. A child, so the figure is this one operation's.
fn _h_capped_reset_peak_kib() {
    var pid = syscall(SYS_FORK);
    if (pid == 0) {
        var fdn = fdn_new(fdn_config_for_room(_h_inf(), F64_ONE, F64_ONE, F64_ONE, 48000));
        var o = fdn_process_sample(fdn, F64_ONE);
        fdn_reset(fdn);
        if (f64_eq(fdn_process_sample(fdn, o), 0) == 0) { syscall(SYS_EXIT, 1); }
        syscall(SYS_EXIT, 0);
    }
    var st[8];
    var ru[144];
    store64(&st, 0);
    syscall(SYS_WAIT4, pid, &st, 0, &ru);
    assert_eq(load64(&st) & 0xFFFFFFFF, 0, "the child resets a capped FDN and reads back silence");
    return load64(&ru + 32);
}

# ================================================================
# 2.1.3 -- allocation refusal ends the process, as Rust's does (ADR-0004). The one
# that mattered was bvh_build: its 0 also means "empty", so a refused build used to
# give a room whose every ray escaped, with no error.
# ================================================================
fn _h_refused_exit_status(which) {
    var pid = syscall(SYS_FORK);
    if (pid == 0) {
        var devnull = syscall(SYS_OPEN, "/dev/null", 1, 0);
        syscall(SYS_DUP2, devnull, 2);
        var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
        var geom = AcousticRoom_geometry(room);
        ALLOC_MAX = 1;
        if (which == 0) { goonj_alloc(1024); }
        if (which == 1) { var b = room_geometry_build_bvh(geom); syscall(SYS_EXIT, 42 + (b == 0)); }
        syscall(SYS_EXIT, 42);
    }
    var st[8];
    store64(&st, 0);
    syscall(SYS_WAIT4, pid, &st, 0, 0);
    return load64(&st) & 0xFFFFFFFF;
}

fn _h_allocation_refusal() {
    test_group("2.1.3: a refused allocation ends the process");
    assert_eq(_h_refused_exit_status(0), 256, "goonj_alloc: exit 1");
    assert_eq(_h_refused_exit_status(1), 256, "room_geometry_build_bvh: exit 1, not an empty BVH");
    return 0;
}

# ================================================================
# 2.2.1 -- the allocation strategy (ADR-0007). Hot paths now work in stack buffers. The
# risk is one escaping: a result that keeps a pointer into a dead frame reads fine until
# the next call overwrites it, so each of these checks a result after more calls.
# ================================================================
fn _h_clobber_stack() {
    var room = acoustic_room_shoebox(f64_from(7), f64_from(6), f64_from(5), acoustic_material_carpet());
    var ray = multiband_ray_new(hvec3_new(F64_ONE, F64_ONE, F64_ONE), hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    var path = trace_ray(ray, RoomGeometry_walls(AcousticRoom_geometry(room)), 8);
    return vec_len(ray_path_bounces(path));
}

fn _h_stack_escape() {
    test_group("2.2.1: nothing a result keeps points into a dead stack frame");
    var src = hvec3_new(f64_from(2), f64_from(2), F64_ONE);
    var lis = hvec3_new(f64_from(6), f64_from(5), F64_ONE);
    var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    var walls = RoomGeometry_walls(AcousticRoom_geometry(room));

    # trace_ray: the input is untouched, and every bounce has its own point on a wall.
    var unit = hvec3_normalize(hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    var ray = multiband_ray_new(src, unit);
    var ux = HVec3_x(mbr_direction(ray));
    var path = trace_ray(ray, walls, 12);
    _h_clobber_stack();
    assert_eq(mbr_origin(ray), src, "trace_ray leaves the ray's origin alone");
    assert_eq(HVec3_x(mbr_direction(ray)), ux, "trace_ray leaves the ray's direction alone");
    assert_eq(mbr_energy_band(ray, 3), F64_ONE, "trace_ray leaves the ray's energy alone");
    var bounces = ray_path_bounces(path);
    assert_eq(vec_len(bounces), 12, "twelve bounces");
    var distinct = 1;
    var on_wall = 1;
    var i = 1;
    while (i < vec_len(bounces)) {
        var p = ray_bounce_point(vec_get(bounces, i));
        var q = ray_bounce_point(vec_get(bounces, i - 1));
        if (p == q) { distinct = 0; }
        var x = HVec3_x(p);
        var y = HVec3_y(p);
        var z = HVec3_z(p);
        var edge = 0;
        if (f64_lt(f64_abs(x), _h_pct(1)) == 1) { edge = 1; }
        if (f64_lt(f64_abs(f64_sub(x, f64_from(10))), _h_pct(1)) == 1) { edge = 1; }
        if (f64_lt(f64_abs(y), _h_pct(1)) == 1) { edge = 1; }
        if (f64_lt(f64_abs(f64_sub(y, f64_from(3))), _h_pct(1)) == 1) { edge = 1; }
        if (f64_lt(f64_abs(z), _h_pct(1)) == 1) { edge = 1; }
        if (f64_lt(f64_abs(f64_sub(z, f64_from(8))), _h_pct(1)) == 1) { edge = 1; }
        if (edge == 0) { on_wall = 0; }
        i = i + 1;
    }
    assert_eq(distinct, 1, "each bounce keeps its own point");
    assert_eq(on_wall, 1, "every kept point is still on a wall");

    # Early reflections keep a direction, and image sources a position, each their own.
    var er = compute_early_reflections(src, lis, room, 2, f64_from(343));
    _h_clobber_stack();
    var unit_ok = 1;
    i = 0;
    while (i < vec_len(er)) {
        var len = hvec3_length(early_reflection_direction(vec_get(er, i)));
        if (f64_lt(f64_abs(f64_sub(len, F64_ONE)), _h_pct(1)) == 0) { unit_ok = 0; }
        i = i + 1;
    }
    assert_gt(vec_len(er), 1, "there are reflections");
    assert_eq(unit_ok, 1, "each reflection's direction is still a unit vector");

    var mats = alloc(48);
    i = 0;
    while (i < 6) {
        store64(mats + i * 8, acoustic_material_concrete());
        i = i + 1;
    }
    var images = compute_image_sources_shoebox(src, f64_from(10), f64_from(3), f64_from(8), mats, 2);
    _h_clobber_stack();
    assert_eq(HVec3_x(image_source_position(vec_get(images, 0))), HVec3_x(src), "direct image is the source");
    assert(image_source_position(vec_get(images, 1)) != image_source_position(vec_get(images, 2)),
      "each image keeps its own position");

    # Diffuse rain reuses one set of bounces, so its contributions must hold copies.
    var rain_cfg = diffuse_rain_config_new(40, 10, F64_ONE, f64_from(4), f64_from(343), 42);
    var rain = generate_diffuse_rain(src, lis, room, rain_cfg);
    _h_clobber_stack();
    var c = DiffuseRainResult_contributions(rain);
    var c_ok = 1;
    var band_ok = 1;
    i = 0;
    while (i < vec_len(c)) {
        var len2 = hvec3_length(lrc_direction(vec_get(c, i)));
        if (f64_lt(f64_abs(f64_sub(len2, F64_ONE)), _h_pct(1)) == 0) { c_ok = 0; }
        if (f64_gt(lrc_energy_band(vec_get(c, i), 0), F64_ONE) == 1) { band_ok = 0; }
        i = i + 1;
    }
    assert_gt(vec_len(c), 1, "there are contributions");
    assert_eq(c_ok, 1, "each contribution's direction is still a unit vector");
    assert_eq(band_ok, 1, "each contribution kept its own energy");

    # trace_beam: the input is untouched, and each hit keeps its own centre.
    var beam = acoustic_beam_new(src, unit, _h_pct(10));
    var bp = trace_beam(beam, walls, 6);
    _h_clobber_stack();
    assert_eq(beam_energy_band(beam, 0), F64_ONE, "trace_beam leaves the beam's energy alone");
    assert_eq(beam_order(beam), 0, "trace_beam leaves the beam's order alone");
    assert_eq(beam_apex(beam), src, "trace_beam leaves the beam's apex alone");
    var hits = beam_path_hits(bp);
    assert_gt(vec_len(hits), 1, "the beam hit walls");
    var first = BeamWallHit_centre(vec_get(hits, 0));
    assert(first != BeamWallHit_centre(vec_get(hits, 1)), "each hit keeps its own centre");

    # The atmospheric path keeps a point per step.
    var wind = wind_profile_new(hvec3_unit_x(), 0, 0);
    var temp = temperature_profile_new(f64_from(20), 0);
    var air = trace_ray_atmospheric(hvec3_new(0, f64_from(10), 0), hvec3_unit_x(), wind, temp, f64_from(5), F64_ONE);
    _h_clobber_stack();
    assert_eq(vec_len(air), 6, "a five-step path has six points");
    assert_eq(HVec3_x(vec_get(air, 5)), f64_from(5), "the last point is five steps out");
    assert_eq(HVec3_x(vec_get(air, 2)), F64_TWO, "an earlier point kept its own value");

    # A step's result must be heap too: it goes straight back to the caller.
    var step = refract_ray_step(src, hvec3_unit_x(), &_h_speed_fn, 0, F64_ONE);
    _h_clobber_stack();
    assert_eq(HVec3_x(RayStep_origin(step)), f64_from(3), "refract_ray_step's origin survives");
    return 0;
}

# The strategy itself: temporaries stay gone. Each of these counted thousands of bytes of
# garbage per call before 2.2.1, which a long-lived consumer never got back.
fn _h_allocation_budget() {
    test_group("2.2.1: hot paths stay inside their allocation budget");
    var src = hvec3_new(f64_from(5), f64_div(f64_from(3), F64_TWO), f64_from(4));
    var lis = hvec3_new(F64_TWO, F64_TWO, F64_TWO);
    var room = acoustic_room_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    var walls = RoomGeometry_walls(AcousticRoom_geometry(room));
    var ray = acoustic_ray_new(src, hvec3_unit_z(), f64_from(1000));
    var mray = multiband_ray_new(src, hvec3_normalize(hvec3_new(F64_ONE, F64_TWO, f64_from(3))));

    var before = alloc_used();
    var i = 0;
    while (i < 1000) {
        var t = ray_wall_intersection(ray, vec_get(walls, 3));
        i = i + 1;
    }
    assert_eq(alloc_used() - before, 0, "ray_wall_intersection allocates nothing");

    before = alloc_used();
    var occluded = is_occluded(src, lis, walls);
    assert_lt(alloc_used() - before, 64, "is_occluded keeps no temporaries");
    assert_eq(occluded, 0, "and answers");

    # 49,824 bytes in 2.2.0. A bounce keeps 120 bytes, plus the vec. This one bounces 36 times.
    before = alloc_used();
    var path = trace_ray(mray, walls, 50);
    assert_lt(alloc_used() - before, 8192, "a trace keeps only its path");
    assert_gt(vec_len(ray_path_bounces(path)), 30, "and really bounced");

    # 3,925,040 bytes in 2.2.0.
    before = alloc_used();
    var rain_cfg = diffuse_rain_config_new(100, 50, F64_TWO, F64_TWO, f64_from(343), 42);
    var rain = generate_diffuse_rain(src, lis, room, rain_cfg);
    assert_lt(alloc_used() - before, 65536, "100 diffuse rays keep only their contributions");
    assert_gt(DiffuseRainResult_total_bounces(rain), 100, "and really bounced");
    return 0;
}

# ================================================================
# 2.3.0 -- the row kernels (ADR-0008). A tolerance can't see what goes wrong here: the
# first version overran its rows by one element on odd lengths and every suite passed.
# So these compare bits. The expected hashes came from 2.2.1, the last scalar solvers,
# on inputs that use only IEEE arithmetic, so no platform's exp or sin is in them.
# ================================================================
var _h_hash = 0;
fn _h_g_reset() { _h_hash = 0xCBF29CE484222325; return 0; }
fn _h_g_mix(v) {
    var i = 0;
    while (i < 8) {
        _h_hash = _h_hash ^ ((v >> (i * 8)) & 255);
        _h_hash = _h_hash * 0x100000001B3;
        i = i + 1;
    }
    return 0;
}
fn _h_g_vec(v) {
    var n = vec_len(v);
    _h_g_mix(n);
    var i = 0;
    while (i < n) {
        _h_g_mix(vec_get(v, i));
        i = i + 1;
    }
    return 0;
}
fn _h_g_signal() {
    var v = vec_new();
    vec_push(v, F64_ONE);
    vec_push(v, f64_neg(F64_HALF));
    vec_push(v, f64_div(F64_ONE, f64_from(3)));
    return v;
}
fn _h_g_walls(k) {
    if (k == 0) { return wall_materials_rigid(); }
    if (k == 1) { return wall_materials_uniform(acoustic_material_carpet()); }
    return wall_materials_new(acoustic_material_concrete(), acoustic_material_carpet(), acoustic_material_wood(),
      acoustic_material_glass(), acoustic_material_tile(), acoustic_material_drywall());
}
fn _h_g_dwm_sweep() {
    _h_g_reset();
    var dx = f64_mul(f64_div(f64_from(343), f64_from(22050)), DWM_SQRT_3);
    var t = f64_div(F64_ONE, f64_from(2000));
    var nx = 3;
    while (nx <= 8) {
        var ny = 3;
        while (ny <= 5) {
            var nz = 3;
            while (nz <= 5) {
                var w = 0;
                while (w < 3) {
                    var sx = 0;
                    while (sx < nx) {
                        var src = alloc(sizeof(DwmSource));
                        DwmSource_set_ix(src, sx);
                        DwmSource_set_iy(src, (nx + ny + nz + sx) % ny);
                        DwmSource_set_iz(src, (sx * 3 + w) % nz);
                        DwmSource_set_signal(src, _h_g_signal());
                        var cfg = dwm_config_new(22050, dx, f64_from(343), nx, ny, nz, t, _h_g_walls(w));
                        var rv = vec_new();
                        vec_push(rv, dwm_receiver_new(nx - 1, ny - 1, nz - 1));
                        vec_push(rv, dwm_receiver_new(nx / 2, ny / 2, nz / 2));
                        var r = solve_dwm_3d(cfg, src, rv);
                        _h_g_vec(DwmResult_final_pressure(r));
                        _h_g_vec(vec_get(DwmResult_receiver_signals(r), 0));
                        _h_g_vec(vec_get(DwmResult_receiver_signals(r), 1));
                        sx = sx + 1;
                    }
                    w = w + 1;
                }
                nz = nz + 1;
            }
            ny = ny + 1;
        }
        nx = nx + 1;
    }
    return _h_hash;
}
fn _h_g_fdtd_sweep() {
    _h_g_reset();
    var dx = f64_mul(f64_div(f64_from(343), f64_from(22050)), f64_div(f64_from(3), F64_TWO));
    var t = f64_div(F64_ONE, f64_from(500));
    var nx = 3;
    while (nx <= 14) {
        var ny = 3;
        while (ny <= 9) {
            var sx = 0;
            while (sx < nx) {
                var cfg = fdtd_config_new(22050, dx, f64_from(343), nx, ny, t);
                var rv = vec_new();
                vec_push(rv, fdtd_receiver_new(nx - 1, ny - 1));
                vec_push(rv, fdtd_receiver_new(nx / 2, ny / 2));
                var r = solve_fdtd_2d(cfg, fdtd_source_new(sx, (sx * 5 + ny) % ny, _h_g_signal()), rv);
                _h_g_vec(FdtdResult_final_pressure(r));
                _h_g_vec(vec_get(FdtdResult_receiver_signals(r), 0));
                _h_g_vec(vec_get(FdtdResult_receiver_signals(r), 1));
                sx = sx + 1;
            }
            ny = ny + 1;
        }
        nx = nx + 1;
    }
    return _h_hash;
}
fn _h_g_diffusion_sweep() {
    _h_g_reset();
    var nx = 3;
    while (nx <= 14) {
        var ny = 3;
        while (ny <= 9) {
            var cells = nx * ny;
            var a = alloc(cells * 8);
            var s = alloc(cells * 8);
            var i = 0;
            while (i < cells) {
                store64(a + i * 8, f64_div(f64_from(i % 7), f64_from(20)));
                i = i + 1;
            }
            store64(s + (cells / 2) * 8, F64_ONE);
            var cfg = diffusion_config_new(F64_HALF, f64_div(F64_ONE, f64_from(10000)), nx, ny, f64_from(343), F64_TWO,
              f64_div(F64_ONE, f64_from(500)));
            var r = solve_diffusion_2d(cfg, a, cells - nx, s, cells);
            _h_g_vec(DiffusionResult_energy_density(r));
            ny = ny + 1;
        }
        nx = nx + 1;
    }
    return _h_hash;
}
fn _h_g_dispersion_sweep() {
    _h_g_reset();
    var b0 = f64_div(f64_from(6), f64_from(5));
    var b1 = f64_neg(f64_div(F64_ONE, f64_from(5)));
    var dc = dispersion_correction_new(b0, b1);
    var n = 0;
    while (n < 600) {
        var v = vec_new();
        var i = 0;
        while (i < n) {
            vec_push(v, f64_div(f64_from((i * 7) % 13 - 6), f64_from(100)));
            i = i + 1;
        }
        dispersion_correction_apply(dc, v);
        _h_g_vec(v);
        n = n + 1;
    }
    return _h_hash;
}

# One sweep of every row op at every length to `max`. Returns how many elements were wrong
# plus how many writes landed past `n`.
fn _h_row_sweep(max) {
    var guard = 0x7FF8DEADBEEF0000;
    var a = alloc((max + 1) * 8);
    var b = alloc((max + 1) * 8);
    var i = 0;
    while (i <= max) {
        store64(a + i * 8, f64_div(f64_from(i + 1), f64_from(3)));
        store64(b + i * 8, f64_div(f64_from(i + 2), f64_from(7)));
        i = i + 1;
    }
    var s = f64_div(f64_from(5), f64_from(9));
    var out = alloc((max + 1) * 8);
    var bad = 0;
    var n = 0;
    while (n <= max) {
        var op = 0;
        while (op < 4) {
            i = 0;
            while (i <= max) {
                store64(out + i * 8, guard);
                i = i + 1;
            }
            if (op == 0) { _row_add(out, a, b, n); }
            if (op == 1) { _row_sub(out, a, b, n); }
            if (op == 2) { _row_mul(out, a, b, n); }
            if (op == 3) { _row_scale(out, a, s, n); }
            i = 0;
            while (i < n) {
                var x = load64(a + i * 8);
                var y = load64(b + i * 8);
                var want = f64_add(x, y);
                if (op == 1) { want = f64_sub(x, y); }
                if (op == 2) { want = f64_mul(x, y); }
                if (op == 3) { want = f64_mul(s, x); }
                if (load64(out + i * 8) != want) { bad = bad + 1; }
                i = i + 1;
            }
            if (load64(out + n * 8) != guard) { bad = bad + 1; }
            op = op + 1;
        }
        n = n + 1;
    }
    return bad;
}

fn _h_row_ops() {
    test_group("2.3.0: row ops touch exactly n elements");
    var saved_min = ROW_WIDE_MIN;
    var saved_wide = _row_wide;
    var avx2 = simd_has_avx2();

    # Default routing, then 128-bit only, then 256-bit from the shortest row it can take.
    assert_eq(_h_row_sweep(80), 0, "default routing: scalar bits, nothing past n");
    _row_wide = 0;
    assert_eq(_h_row_sweep(80), 0, "128-bit path");
    _row_wide = avx2;
    ROW_WIDE_MIN = 1;
    assert_eq(_h_row_sweep(80), 0, "256-bit path, where the CPU has it");
    ROW_WIDE_MIN = saved_min;
    _row_wide = saved_wide;

    # An aliased row, as the kernels use them.
    var a = alloc(64);
    var b = alloc(64);
    var c = alloc(64);
    var i = 0;
    while (i < 7) {
        store64(a + i * 8, f64_div(f64_from(i + 1), f64_from(3)));
        store64(b + i * 8, f64_div(f64_from(i + 2), f64_from(7)));
        store64(c + i * 8, load64(a + i * 8));
        i = i + 1;
    }
    _row_add(c, c, b, 7);
    assert_eq(load64(c + 6 * 8), f64_add(load64(a + 6 * 8), load64(b + 6 * 8)), "out may alias a");

    # _vec_data relies on lib/vec.cyr's documented layout. If that moves, this says so.
    var v = vec_new();
    vec_push(v, 11);
    vec_push(v, 22);
    assert_eq(load64(_vec_data(v) + 8), 22, "a vec's elements start at its first word");
    return 0;
}

fn _h_golden_sweeps() {
    assert_eq(_h_g_dwm_sweep(), 0x389B6C33178DDA61, "DWM: odd and even rows, every source class, three wall sets");
    assert_eq(_h_g_fdtd_sweep(), 0xF165376846C6C0F0, "FDTD: odd and even rows, every source position");
    assert_eq(_h_g_diffusion_sweep(), 0x04C1EA59BE0B7F1C, "diffusion: odd and even rows");
    assert_eq(_h_g_dispersion_sweep(), 0xEF668F69A5BCC2BB, "dispersion: every length through two chunks");
    return 0;
}

# These grids are small, so left alone they would never reach the 256-bit kernels. Each
# path gets the same four hashes: a path no test runs is how the odd-row overrun got through.
fn _h_row_kernels() {
    test_group("2.3.0: row kernels give the bits the scalar solvers gave");
    var saved_min = ROW_WIDE_MIN;
    var saved_wide = _row_wide;
    _h_golden_sweeps();
    _row_wide = 0;
    _h_golden_sweeps();
    _row_wide = simd_has_avx2();
    ROW_WIDE_MIN = 1;
    _h_golden_sweeps();
    ROW_WIDE_MIN = saved_min;
    _row_wide = saved_wide;
    return 0;
}

alloc_init();
_h_fdtd();
_h_dwm();
_h_material();
_h_metamaterial();
_h_analysis();
_h_propagation();
_h_ir_sample_count();
_h_index_guards();
_h_f64_to_saturation();
_h_nan_vertex();
_h_band_accessors();
_h_nan_parity();
_h_negative_counts();
_h_runaway_loops();
_h_stable_sort();
_h_fdn_lines_are_vecs();
_h_fdn_lazy();
_h_allocation_refusal();
_h_stack_escape();
_h_allocation_budget();
_h_row_ops();
