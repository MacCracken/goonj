# dwm.bcyr -- benchmark for the DWM solver hot path (solve_dwm_3d).
# Run: cyrius bench tests/dwm.bcyr

include "lib/sakshi.cyr"
include "src/error.cyr"
include "src/material.cyr"
include "src/hybrid.cyr"
include "src/fdtd.cyr"
include "src/logging.cyr"
include "src/dwm.cyr"

fn bench(name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    bench_report(b);
    return 0;
}

var _cfg_small = 0;
var _cfg_med = 0;
var _cfg_default = 0;
var _src = 0;
var _src_default = 0;
var _dc = 0;
var _dsig = 0;
var _no_recv = 0;      # pre-built empty receivers vec (Rust builds its list once)

# Full solve on a rigid box (the triple-loop grid sweep is the hot path).
fn b_solve_small() { return solve_dwm_3d(_cfg_small, _src, _no_recv); }
fn b_solve_med() { return solve_dwm_3d(_cfg_med, _src, _no_recv); }
# Default config = 30x25x20 grid @ 50 ms. Matches the Rust
# dwm/solve_30x25x20_50ms GRID and step count (15,000 cells, 1,102 steps).
# Two differences that do not touch the hot loop: Rust ran f32 where this runs
# f64, and Rust passed one receiver where this passes none — so Rust also paid
# ~1,102 receiver samples per iteration. Do not read the ratio as exact.
fn b_solve_default() { return solve_dwm_3d(_cfg_default, _src_default, _no_recv); }
# dwm/dispersion_correct — 2-tap FIR over a 22050-sample (1 s) tone. Applied in
# place; repeated application costs the same O(n) each call (matches Rust's
# per-iter apply, minus its fresh clone).
fn b_dispersion() { return dispersion_correction_apply(_dc, _dsig); }

fn main() {
    alloc_init();
    var dx = required_dx(22050, f64_from(343));
    var dur = f64_div(F64_ONE, f64_from(100));   # 0.01 s (~220 steps at 22050 Hz)
    # 16^3 ≈ 4k cells and 24^3 ≈ 14k cells — shows near-linear scaling in cells.
    _cfg_small = dwm_config_new(22050, dx, f64_from(343), 16, 16, 16, dur, wall_materials_rigid());
    _cfg_med = dwm_config_new(22050, dx, f64_from(343), 24, 24, 24, dur, wall_materials_rigid());
    _src = dwm_source_gaussian_pulse(8, 8, 8, 5, F64_TWO, F64_ONE);
    # Default config: 30x25x20 @ 0.05 s (matches Rust dwm/solve_30x25x20_50ms).
    _cfg_default = dwm_config_default();
    _src_default = dwm_source_gaussian_pulse(15, 12, 10, 5, F64_TWO, F64_ONE);
    # dispersion correction over a 22050-sample 1 kHz tone (matches Rust).
    _dc = dispersion_correction_for_config(dwm_config_default());
    _no_recv = vec_new();
    _dsig = vec_new();
    var di = 0;
    while (di < 22050) {
        vec_push(_dsig, f64_sin(f64_div(f64_mul(f64_mul(F64_TAU, f64_from(1000)), f64_from(di)), f64_from(22050))));
        di = di + 1;
    }

    bench("solve_dwm_3d_16cubed_0.01s", &b_solve_small, 30);
    bench("solve_dwm_3d_24cubed_0.01s", &b_solve_med, 15);
    bench("solve_dwm_3d_30x25x20_50ms", &b_solve_default, 5);
    bench("dwm/dispersion_correct_22kHz_1s", &b_dispersion, 2000);
    return 0;
}

var r = main();
syscall(60, r);
