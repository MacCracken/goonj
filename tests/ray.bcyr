# ray.bcyr -- benchmarks for the ray-tracing hot path, matching the Rust
# `ray/*` benchmarks in rust-old/benches/benchmarks.rs config-for-config.
# Run: cyrius bench tests/ray.bcyr

include "lib/hisab.cyr"
include "src/error.cyr"
include "src/material.cyr"
include "src/propagation.cyr"
include "src/room.cyr"
include "src/ray.cyr"

fn bench(name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    bench_report(b);
    return 0;
}

# Pre-built scenes (initialized in main).
var _probe_ray = 0;    # AcousticRay for wall_intersection
var _probe_wall = 0;   # a single Wall
var _shoe_walls = 0;   # 6-wall shoebox geometry walls
var _shoe_src = 0;     # (5, 1.5, 4)
var _rays100 = 0;      # 100 MultibandRays spread over ~2π
var _many_walls = 0;   # 100-wall room geometry walls (linear)
var _many_accel = 0;   # 100-wall AcceleratedRoom (BVH)
var _many_ray = 0;     # MultibandRay from (10, 1.5, 10) along +X

# ray/wall_intersection — one ray↔quad test.
fn b_wall_intersection() { return ray_wall_intersection(_probe_ray, _probe_wall); }
# ray/trace_single_shoebox — one multiband ray, 50 bounces, 6-wall shoebox.
fn b_trace_single() { return trace_ray(multiband_ray_new(_shoe_src, hvec3_unit_z()), _shoe_walls, 50); }
# ray/trace_100_rays_shoebox — trace all 100 pre-built rays (50 bounces each).
fn b_trace_100_rays() {
    var i = 0;
    while (i < 100) {
        trace_ray(vec_get(_rays100, i), _shoe_walls, 50);
        i = i + 1;
    }
    return 0;
}
# ray/trace_linear_100_walls — linear trace through a 100-wall room, 50 bounces.
fn b_trace_linear_100() { return trace_ray(_many_ray, _many_walls, 50); }
# ray/trace_bvh_100_walls — BVH trace through the same 100-wall room.
fn b_trace_bvh_100() { return trace_ray_bvh(_many_ray, _many_accel, 50); }

# Build a 100-wall AcousticRoom: shoebox(20,20,3) + 94 drywall partitions
# (replicates the Rust make_many_wall_room(94) helper).
#must_use
fn _many_wall_room() {
    var room = acoustic_room_shoebox(f64_from(20), f64_from(20), f64_from(3), acoustic_material_concrete());
    var walls = RoomGeometry_walls(AcousticRoom_geometry(room));
    var mat = acoustic_material_drywall();
    var i = 0;
    while (i < 94) {
        var x = f64_add(F64_ONE, f64_div(f64_mul(f64_from(i), f64_from(18)), f64_from(94)));
        var verts = vec_new();
        vec_push(verts, hvec3_new(x, 0, f64_from(9)));
        vec_push(verts, hvec3_new(x, f64_from(3), f64_from(9)));
        vec_push(verts, hvec3_new(x, f64_from(3), f64_from(11)));
        vec_push(verts, hvec3_new(x, 0, f64_from(11)));
        vec_push(walls, wall_new(verts, mat, hvec3_unit_x()));
        i = i + 1;
    }
    return room;
}

fn main() {
    alloc_init();
    var half3 = f64_div(f64_from(3), F64_TWO);   # 1.5

    # wall_intersection: ray (2.5,1.5,0)->+Z, quad wall at z=5.
    _probe_ray = acoustic_ray_new(hvec3_new(f64_div(f64_from(5), F64_TWO), half3, 0), hvec3_unit_z(), f64_from(1000));
    var wverts = vec_new();
    vec_push(wverts, hvec3_new(0, 0, f64_from(5)));
    vec_push(wverts, hvec3_new(f64_from(5), 0, f64_from(5)));
    vec_push(wverts, hvec3_new(f64_from(5), f64_from(3), f64_from(5)));
    vec_push(wverts, hvec3_new(0, f64_from(3), f64_from(5)));
    _probe_wall = wall_new(wverts, acoustic_material_concrete(), hvec3_new(0, 0, f64_neg(F64_ONE)));

    # shoebox(10,8,3) scenes.
    var shoe = room_geometry_shoebox(f64_from(10), f64_from(8), f64_from(3), acoustic_material_concrete());
    _shoe_walls = RoomGeometry_walls(shoe);
    _shoe_src = hvec3_new(f64_from(5), half3, f64_from(4));

    # 100 rays spread over ~2π (dir = (cos, 0.1, sin)); angle = i*0.0628.
    _rays100 = vec_new();
    var ai = 0;
    var step = f64_div(f64_from(628), f64_from(10000));   # 0.0628
    var tenth = f64_div(F64_ONE, f64_from(10));            # 0.1
    while (ai < 100) {
        var angle = f64_mul(f64_from(ai), step);
        var dir = hvec3_new(f64_cos(angle), tenth, f64_sin(angle));
        vec_push(_rays100, multiband_ray_new(_shoe_src, dir));
        ai = ai + 1;
    }

    # 100-wall room (linear + BVH).
    var mroom = _many_wall_room();
    _many_walls = RoomGeometry_walls(AcousticRoom_geometry(mroom));
    _many_accel = accelerated_room_new(mroom);
    _many_ray = multiband_ray_new(hvec3_new(f64_from(10), half3, f64_from(10)), hvec3_unit_x());

    bench("ray/wall_intersection", &b_wall_intersection, 200000);
    bench("ray/trace_single_shoebox", &b_trace_single, 20000);
    bench("ray/trace_100_rays_shoebox", &b_trace_100_rays, 200);
    bench("ray/trace_linear_100_walls", &b_trace_linear_100, 3000);
    bench("ray/trace_bvh_100_walls", &b_trace_bvh_100, 3000);
    return 0;
}

var r = main();
syscall(60, r);
