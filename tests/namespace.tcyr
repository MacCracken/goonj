# namespace.tcyr -- goonj's names against the names its consumers' units also define.
#
# A bundle shares one flat namespace with everything else in the consumer's unit, and a
# redefined enum member takes the LAST definition at every use, including uses compiled
# before it. The compiler only warns. Through 2.3.1 two goonj families collided:
#
#   - DhvaniLayout's DH_SIZE = 88 against yukti's DH_SIZE = 24. In dhvani's unit, which
#     includes yukti after goonj, generate_dhvani_ir allocated 24 bytes and wrote 88.
#   - LogLevel's LOG_FATAL = 0 .. LOG_TRACE = 5 against stdlib log's LOG_TRACE = 0 ..
#     LOG_FATAL = 5. With log after goonj, logging_init_verbose() set fatal-only.
#
# The two enums below are copied verbatim from the cyrius 6.7.18 snapshot (lib/yukti.cyr,
# yukti 2.3.18, and lib/log.cyr), and come after the bundle, as they do in a consumer.
# Against 2.3.1's bundle, with its names, 5 of these 11 assertions fail: the next
# allocation is 24 bytes on, rt60 is overwritten, and verbose init reads 0.
# scripts/check-namespace.sh is the general gate: no top-level goonj name may appear in
# the pinned toolchain's stdlib.
#
# Run: cyrius test tests/namespace.tcyr
include "lib/hisab.cyr"
include "lib/sakshi.cyr"
include "dist/goonj.cyr"

enum DeviceHealthField {
    DH_ROTATIONAL = 0;
    DH_TEMP = 8;
    DH_SCHEDULER = 16;
    DH_SIZE = 24;
}

enum LogLevel {
    LOG_TRACE = 0;
    LOG_DEBUG = 1;
    LOG_INFO  = 2;
    LOG_WARN  = 3;
    LOG_ERROR = 4;
    LOG_FATAL = 5;
}

fn _n_dhvani_ir_keeps_its_88_bytes() {
    test_group("namespace: a DhvaniIr is 88 bytes with yukti's DH_SIZE in the unit");
    var room = acoustic_room_shoebox(f64_from(5), f64_from(4), f64_from(3),
      acoustic_material_wood());
    var d = generate_dhvani_ir(hvec3_new(f64_from(2), 0x3FF8000000000000, f64_from(2)),
      hvec3_new(f64_from(3), 0x3FF8000000000000, f64_from(2)), room, ir_config_default());
    var n = alloc(64);
    # A bump allocator hands out the next block above d unless it opened a new chunk.
    var gap_ok = 1;
    if (n > d) {
        if (n - d < DHVANI_IR_SIZE) { gap_ok = 0; }
    }
    assert_eq(gap_ok, 1, "the next allocation starts at least 88 bytes past the DhvaniIr");
    assert_eq(DHVANI_IR_SIZE, 88, "DHVANI_IR_SIZE is 88");

    var before = 0;
    var b = 0;
    while (b < NUM_BANDS) {
        before = before + dhvani_ir_rt60_band(d, b);
        b = b + 1;
    }
    var i = 0;
    while (i < 8) {
        store64(n + i * 8, 0x4141414141414141);
        i = i + 1;
    }
    var after = 0;
    b = 0;
    while (b < NUM_BANDS) {
        after = after + dhvani_ir_rt60_band(d, b);
        b = b + 1;
    }
    assert_eq(after, before, "writing the next allocation leaves every rt60 band alone");
    assert_eq(dhvani_ir_has_multiband(d), 1, "the multiband slot is intact");
}

fn _n_logging_keeps_sakshi_levels() {
    test_group("namespace: logging levels are sakshi's with stdlib log's in the unit");
    # sakshi: 0 = fatal .. 5 = trace. Numerals, not names: the names are what collided.
    logging_init_verbose();
    assert_eq(sakshi_get_level(), 5, "verbose init -> sakshi trace (5)");
    logging_set_level(GOONJ_LOG_DEBUG);
    assert_eq(sakshi_get_level(), 4, "GOONJ_LOG_DEBUG -> sakshi debug (4)");
    assert_eq(_logging_level_from_name("trace"), 5, "GOONJ_LOG=trace -> 5");
    assert_eq(_logging_level_from_name("fatal"), 0, "GOONJ_LOG=fatal -> 0");
    assert_eq(GOONJ_LOG_WARN, 2, "GOONJ_LOG_WARN is sakshi warn (2)");
    # The consumer's own names still mean what its own module says.
    assert_eq(LOG_TRACE, 0, "the unit's LOG_TRACE is stdlib log's");
    assert_eq(DH_SIZE, 24, "the unit's DH_SIZE is yukti's");
    logging_set_level(GOONJ_LOG_WARN);
}

_n_dhvani_ir_keeps_its_88_bytes();
_n_logging_keeps_sakshi_levels();

var rc = assert_summary();
syscall(60, rc);
